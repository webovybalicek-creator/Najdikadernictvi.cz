  RewriteRule ^liberec/kadernictvi-nam-postovni-25-5/?$ /liberec/kadernictvi-sazi/ [L,R=301]
  RewriteRule ^plzen/ermani-hair-group-s-r-o/?$ /plzen/ermani-hair-group/ [L,R=301]
  RewriteRule ^usti-nad-labem/kadernictvi-parizska-1290-5/?$ /usti-nad-labem/matty-s-barbershop/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-martinska-303-9/?$ /plzen/paul-s-barber-shop/ [L,R=301]
  RewriteRule ^ostrava/kadernictvi-purkynova-787-6/?$ /ostrava/realcutz-barbershop/ [L,R=301]
  RewriteRule ^liberec/kadernictvi-tyrsova-508-5/?$ /liberec/salon-h2o2/ [L,R=301]
  RewriteRule ^olomouc/svet-vlasu-s-r-o/?$ /olomouc/salon-verto/ [L,R=301]
  RewriteRule ^ceske-budejovice/kadernictvi-staromestska-2769-10/?$ /ceske-budejovice/sandra-studio/ [L,R=301]
  RewriteRule ^liberec/kadernictvi-na-jezirku-335-10/?$ /liberec/shairent/ [L,R=301]
  RewriteRule ^ostrava/kadernictvi-dvorakova-1515-2/?$ /ostrava/studio-karin/ [L,R=301]
  RewriteRule ^hradec-kralove/kadernictvi-dlouha-101-13/?$ /hradec-kralove/the-royal-barbershop/ [L,R=301]
  RewriteRule ^liberec/kadernictvi-ruzova-323-4/?$ /liberec/theplace/ [L,R=301]
  RewriteRule ^ostrava/kadernictvi-17-listopadu-768-68/?$ /ostrava/unique-barber-shop/ [L,R=301]
  RewriteRule ^praha-10/kadernictvi-krymska-166-43/?$ /praha-10/viktoriia-beauty-salon/ [L,R=301]
  RewriteRule ^pardubice/kadernictvi-strossova-511/?$ /pardubice/kadernictvi-linda/ [L,R=301]
  RewriteRule ^ceske-budejovice/kadernictvi-k-safare-887-64/?$ /ceske-budejovice/kadernictvi-sumava/ [L,R=301]
  # Duplicitní záznam z OSM s chybnou obcí Zavadilka (správně České Budějovice, K. Šafáře 887/64)
  RewriteRule ^zavadilka/kadernictvi-sumava/?$ /ceske-budejovice/kadernictvi-sumava/ [L,R=301]
  RewriteRule ^zavadilka/?$ /ceske-budejovice/ [L,R=301]

  # Zrušený přehled krajů – hledání je na úvodní stránce
  RewriteRule ^kraje/?$ / [L,R=301]

  # Překlep v adrese statistiky
  RewriteRule ^navstevnost/?$ /navstenost/ [L,R=301]
</IfModule>

# Interní soubory deploye nezveřejňovat
<FilesMatch "^\.(deploy-manifest\.txt|ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# ---------------------------------------------------------------- mezipaměť prohlížeče
# (soubory v /_astro/ mají vlastní .htaccess s ročním cachováním, viz public/_astro/.htaccess)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
