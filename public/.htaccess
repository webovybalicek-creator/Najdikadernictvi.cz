  RewriteRule ^olomouc/kadernictvi-schweitzerova-798-99/?$ /olomouc/fresh-cut-barbers/ [L,R=301]
  RewriteRule ^usti-nad-labem/kadernictvi-bozdechova-97-2/?$ /usti-nad-labem/gentleman-salon/ [L,R=301]
  RewriteRule ^olomouc/kadernictvi-pavlovicka-272-18/?$ /olomouc/goldman-barber/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-bezrucova-184-29/?$ /plzen/grand-barber-shop/ [L,R=301]
  RewriteRule ^ostrava/kadernictvi-17-listopadu-676-46/?$ /ostrava/grease-barbershop/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-koterovska-651-33/?$ /plzen/hary-s-barber-shop/ [L,R=301]
  RewriteRule ^liberec/jp24-s-r-o/?$ /liberec/holicstvi-24/ [L,R=301]
  RewriteRule ^praha-8/kadernictvi-za-poricskou-branou-334-4/?$ /praha-8/old-school-barbershop/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-divadelni-2920-14/?$ /plzen/hot-hair/ [L,R=301]
  RewriteRule ^usti-nad-labem/kadernictvi-brnenska-916-1/?$ /usti-nad-labem/hygie-panske-kadernictvi/ [L,R=301]
  RewriteRule ^liberec/kadernictvi-vitezna-665-19/?$ /liberec/kadernictvi-007/ [L,R=301]
