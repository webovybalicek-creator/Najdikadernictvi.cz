Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ověřování certifikátu (AutoSSL) nechat bez přesměrování
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  # http → https a www → bez www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://najdikadernictvi.cz%{REQUEST_URI} [L,R=301]

  # Sloučené články blogu (listopad 2026)
  RewriteRule ^blog/fenovani-doma/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/pece-o-barvene-vlasy/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/kudrnate-vlasy/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/sediny-barvit-nebo-nechat/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/barveni-vlasu-melir-balayage-ombre/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/trvala-na-vlasy/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/keratinove-narovnani-vlasu/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/prodluzovani-vlasu/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/damske-strihy-podle-tvaru-obliceje/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/strihy-pro-jemne-vlasy/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/rychle-ucesy-na-kazdy-den/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/svatebni-uces/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/pomada-vosk-hlina-gel/?$ /blog/panske-strihy-prehled/ [L,R=301]
  RewriteRule ^blog/panske-strihy-ridnouci-vlasy/?$ /blog/panske-strihy-prehled/ [L,R=301]
  RewriteRule ^blog/jak-se-pripravit-na-kadernictvi/?$ /blog/jak-vybrat-kadernika/ [L,R=301]
  RewriteRule ^blog/dysko-u-kadernika/?$ /blog/jak-vybrat-kadernika/ [L,R=301]

  # Zrušený přehled krajů – hledání je na úvodní stránce
  RewriteRule ^kraje/?$ / [L,R=301]

  # Překlep v adrese statistiky
  RewriteRule ^navstevnost/?$ /navstenost/ [L,R=301]
</IfModule>

# Interní soubory deploye nezveřejňovat
<FilesMatch "^\.(deploy-manifest\.txt|ftp-deploy-sync-state\.json)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# ---------------------------------------------------------------- mezipaměť prohlížeče
# (soubory v /_astro/ mají vlastní .htaccess s ročním cachováním, viz public/_astro/.htaccess)
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=600, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(json|xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/avif .avif
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>
