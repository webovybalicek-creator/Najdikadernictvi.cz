Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Ověřování certifikátu (AutoSSL) nechat bez přesměrování
  RewriteCond %{REQUEST_URI} ^/\.well-known/ [NC]
  RewriteRule ^ - [L]

  # http → https a www → bez www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://najdikadernictvi.cz%{REQUEST_URI} [L,R=301]

  # Sloučené články blogu (listopad 2026)
  RewriteRule ^blog/fenovani-doma/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/pece-o-barvene-vlasy/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/kudrnate-vlasy/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/sediny-barvit-nebo-nechat/?$ /blog/pece-o-vlasy-doma/ [L,R=301]
  RewriteRule ^blog/barveni-vlasu-melir-balayage-ombre/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/trvala-na-vlasy/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/keratinove-narovnani-vlasu/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/prodluzovani-vlasu/?$ /blog/salonni-sluzby-pro-zeny/ [L,R=301]
  RewriteRule ^blog/damske-strihy-podle-tvaru-obliceje/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/strihy-pro-jemne-vlasy/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/rychle-ucesy-na-kazdy-den/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/svatebni-uces/?$ /blog/damske-strihy-a-ucesy/ [L,R=301]
  RewriteRule ^blog/pomada-vosk-hlina-gel/?$ /blog/panske-strihy-prehled/ [L,R=301]
  RewriteRule ^blog/panske-strihy-ridnouci-vlasy/?$ /blog/panske-strihy-prehled/ [L,R=301]
  RewriteRule ^blog/jak-se-pripravit-na-kadernictvi/?$ /blog/jak-vybrat-kadernika/ [L,R=301]
  RewriteRule ^blog/dysko-u-kadernika/?$ /blog/jak-vybrat-kadernika/ [L,R=301]

  # Salony přejmenované podle veřejného názvu (fotky, listopad 2026)
  RewriteRule ^ceske-budejovice/factory-barbershop-s-r-o/?$ /ceske-budejovice/factory-barbershop/ [L,R=301]
  RewriteRule ^ostrava/champions-barber-shop-privozska-s-r-o/?$ /ostrava/champions-barber-shop-privozska/ [L,R=301]
  RewriteRule ^ostrava/champions-barber-shop-poruba-s-r-o/?$ /ostrava/champions-barber-shop-poruba/ [L,R=301]
  RewriteRule ^brno/salon-goldenhair-s-r-o/?$ /brno/salon-goldenhair/ [L,R=301]
  RewriteRule ^praha-3/kadernictvi-husitska-76-27/?$ /praha-3/tata-barbershop/ [L,R=301]
  RewriteRule ^ostrava/kadernictvi-jugoslavska-2957-40/?$ /ostrava/alessandro-barbershop/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-houskova-499-7/?$ /plzen/barber-7/ [L,R=301]
  RewriteRule ^usti-nad-labem/kadernictvi-masarykova-3127-28/?$ /usti-nad-labem/aspekt-studio/ [L,R=301]
  RewriteRule ^usti-nad-labem/kadernictvi-masarykova-827-191/?$ /usti-nad-labem/kadernictvi-hair4u/ [L,R=301]
  RewriteRule ^liberec/kadernictvi-5-kvetna-37-26/?$ /liberec/blessed-barbershop/ [L,R=301]
  RewriteRule ^brno/kb-promotion-s-r-o/?$ /brno/bubeliny-barber-shop/ [L,R=301]
  RewriteRule ^ceske-budejovice/kadernictvi-husova-tr-685-17/?$ /ceske-budejovice/cavalier-barber/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-havlickova-971-16/?$ /plzen/cavalier-barber-studio/ [L,R=301]
  RewriteRule ^ceske-budejovice/kadernictvi-nova-1992-28/?$ /ceske-budejovice/caveman-barbershop/ [L,R=301]
  RewriteRule ^brno/growlead-s-r-o/?$ /brno/cutegory/ [L,R=301]
  RewriteRule ^plzen/kadernictvi-veleslavinova-32-28/?$ /plzen/desert-bloom-hair-salon/ [L,R=301]
