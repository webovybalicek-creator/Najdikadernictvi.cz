---
import '@fontsource-variable/outfit';
import '../styles/global.css';
import { SITE } from '../lib/config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Náhledový obrázek pro sdílení (absolutní nebo kořenová cesta), výchozí /og.jpg 1200×630 */
  obrazek?: { src: string; alt?: string; w?: number; h?: number };
  typ?: 'website' | 'article';
  publikovano?: string;
}

const { title, description, jsonLd, noindex = false, obrazek, typ = 'website', publikovano } = Astro.props;
const og = {
  src: new URL(obrazek?.src ?? '/og.jpg', SITE.url).href,
  alt: obrazek?.alt ?? 'Najdi kadeřnictví – kadeřnictví a barbershopy v celém Česku',
  w: obrazek?.w ?? 1200,
  h: obrazek?.h ?? 630,
};
const canonical = new URL(Astro.url.pathname, SITE.url).href;
// Reklamy jen na stránkách s plnohodnotným obsahem (ne na chudých detailech, hledání apod.)
const reklamy = !!SITE.adsense && SITE.indexovat && !noindex;
const robots = !SITE.indexovat || noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large';
// Značku přidat jen ke krátkým titulkům – u dlouhých by Google usekl to důležité (název webu ukazuje zvlášť)
const fullTitle = title.includes(SITE.nazev) || title.length > 42 ? title : `${title} | ${SITE.nazev}`;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    {SITE.googleOvereni && <meta name="google-site-verification" content={SITE.googleOvereni} />}
    {SITE.bingOvereni && <meta name="msvalidate.01" content={SITE.bingOvereni} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f6f4ef" />
    <meta property="og:type" content={typ} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={SITE.nazev} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og.src} />
    <meta property="og:image:width" content={String(og.w)} />
    <meta property="og:image:height" content={String(og.h)} />
    <meta property="og:image:alt" content={og.alt} />
    {publikovano && <meta property="article:published_time" content={publikovano} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og.src} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {
      reklamy && (
        <>
          <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500});`} />
          <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsense}`} crossorigin="anonymous" />
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="sr-only" href="#obsah">Přejít na obsah</a>
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer reklamy={reklamy} />
    <script>
      import { nuzkyNaTlacitka } from '../scripts/nuzky';
      import { doplnHodnoceni } from '../scripts/hodnoceni-souhrn';
      import { inicializujSrdicka, inicializujPocitadlo, inicializujPorovnani, inicializujListuPorovnani } from '../scripts/oblibene';
      nuzkyNaTlacitka();
      doplnHodnoceni();
      inicializujSrdicka();
      inicializujPocitadlo();
      inicializujPorovnani();
      inicializujListuPorovnani();

      // Anonymní počítání zobrazení (bez cookies a osobních údajů), jen na produkčním webu
      let nemerit = false;
      try {
        nemerit = localStorage.getItem('nk-nemerit') === '1';
      } catch {
        /* bez úložiště */
      }
      if (location.hostname.endsWith('najdikadernictvi.cz') && !navigator.webdriver && !nemerit) {
        let r = '';
        try {
          r = document.referrer ? new URL(document.referrer).hostname : '';
        } catch {
          /* neplatný referrer */
        }
        const d = new URLSearchParams({ p: location.pathname, r });
        navigator.sendBeacon?.('/api/stat.php', d) || fetch('/api/stat.php', { method: 'POST', body: d, keepalive: true }).catch(() => {});
      }
    </script>
  </body>
</html>
