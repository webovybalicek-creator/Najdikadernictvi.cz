---
import { SITE } from '../lib/config';

interface Props {
  items: { nazev: string; href?: string }[];
}
const items = [{ nazev: 'Úvod', href: '/' }, ...Astro.props.items];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((i, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: i.nazev,
    ...(i.href ? { item: new URL(i.href, SITE.url).href } : {}),
  })),
};
---

<nav class="breadcrumb" aria-label="Drobečková navigace">
  <ol>
    {items.map((i) => <li>{i.href ? <a href={i.href}>{i.nazev}</a> : <span aria-current="page">{i.nazev}</span>}</li>)}
  </ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
