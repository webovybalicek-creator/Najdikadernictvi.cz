---
import Overeno from './Overeno.astro';
import Vizual from './Vizual.astro';
import { adresa, tyden, url, indexovatDetail, vlastnosti, cenaOd, TYP_NAZEV, ZAMERENI_NAZEV, type Provozovna } from '../lib/data';

interface Props {
  p: Provozovna;
  vzdalenost?: number;
  sMestem?: boolean;
  /** Malý náhled „pohled z ulice“ (stojí kredity Mapy.com, jen ve výpisech měst) */
  nahled?: boolean;
  /** Statický řádek pod adresou (např. otevírací doba k tématu výběru, telefon) */
  detail?: string;
}
const { p, vzdalenost, sMestem = false, nahled = false, detail } = Astro.props;
const t = tyden(p);
const cena = cenaOd(p);
// Profily, které neindexujeme (jen z rejstříku), Google nemusí procházet
const rel = indexovatDetail(p) ? undefined : 'nofollow';
---

<li
  class:list={['row', nahled && 'row--nahled']}
  data-id={p.id}
  data-nazev={p.nazev}
  data-lat={p.lat}
  data-lon={p.lon}
  data-typ={p.typ}
  data-zamereni={vlastnosti(p).join(' ')}
  data-cena={cena}
  data-oh={t ? JSON.stringify(t) : undefined}
  data-hledat={`${p.nazev} ${p.ulice ?? ''} ${p.cast ?? ''}`.toLowerCase()}
>
  {
    nahled && (
      <a class="row__img" href={url(p)} rel={rel} tabindex="-1" aria-hidden="true">
        <Vizual p={p} panorama />
      </a>
    )
  }
  <div class="row__main">
    <h3 class="row__name"><a href={url(p)} rel={rel}>{p.nazev}</a>{p.overeno && <Overeno mini />}</h3>
    <p class="row__adr">{adresa(p, sMestem) || p.mesto} <span class="hod-mini" data-hod-id={p.id}><span class="hv" style="--p:0%"></span></span></p>
    {detail && <p class="row__detail">{detail}</p>}
  </div>
  <div class="row__meta">
    <span class:list={['tag', p.typ === 'barber' && 'tag--barber']}>{TYP_NAZEV[p.typ]}</span>
    {p.zamereni.filter((z) => z !== 'unisex').map((z) => <span class="tag">{ZAMERENI_NAZEV[z]}</span>)}
    {cena && <span class="row__cena" title={p.cena!.zdroj === 'cenik' ? 'Podle ceníku salonu' : 'Podle cen od návštěvníků'}>střih od {cena.toLocaleString('cs-CZ')} Kč</span>}
    {vzdalenost != null && <span class="row__km">{vzdalenost < 1 ? `${Math.round(vzdalenost * 1000)} m` : `${vzdalenost.toFixed(1).replace('.', ',')} km`}</span>}
    {t && <span class="stav" />}
  </div>
</li>

<style is:global>
  .row__detail {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .row {
    content-visibility: auto;
    contain-intrinsic-size: auto 96px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1.5rem;
    align-items: center;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row--nahled {
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
  }
  .row__img {
    display: block;
    width: 6.5rem;
  }
  .row__img .viz {
    aspect-ratio: 4 / 3;
  }
  .row__img .viz__mono {
    font-size: 1.4rem;
  }
  .row__name {
    font-family: var(--f-display);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.25;
    margin: 0;
  }
  .row__name a {
    text-decoration: none;
  }
  .row__name a:hover {
    text-decoration: underline;
  }
  .row__adr {
    margin: 0.15rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-soft);
  }
  .row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.6rem;
    align-items: center;
    justify-content: flex-end;
  }
  .row__cena {
    font-size: 0.875rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .row__km {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .row[hidden] {
    display: none;
  }
  .row .stav:empty {
    display: none;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row--nahled {
      grid-template-columns: 5.5rem minmax(0, 1fr);
    }
    .row--nahled .row__img {
      width: 5.5rem;
      grid-row: span 2;
    }
    .row__meta {
      justify-content: flex-start;
    }
  }
</style>
