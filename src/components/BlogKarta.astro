---
import { Picture } from 'astro:assets';
import { clanekUrl, casCteni, type Clanek } from '../lib/blog';

interface Props {
  c: Clanek;
  velka?: boolean;
}
const { c, velka = false } = Astro.props;
---

<article class:list={['bk', velka && 'bk--velka']}>
  <a href={clanekUrl(c)}>
    <div class="bk__img">
      <Picture formats={['avif', 'webp']}
        src={c.data.obrazek}
        alt={c.data.obrazekAlt}
        widths={velka ? [480, 800, 1200] : [400, 640, 800]}
        sizes={velka ? '(max-width: 860px) 100vw, 60vw' : '(max-width: 640px) 100vw, 33vw'}
        loading={velka ? 'eager' : 'lazy'}
      />
    </div>
    <div class="bk__txt">
      <p class="bk__meta"><span>{c.data.kategorie}</span><span>{casCteni(c)} min čtení</span></p>
      <h3 class="bk__nazev">{c.data.title}</h3>
      <p class="bk__perex">{c.data.perex}</p>
    </div>
  </a>
</article>

<style>
  .bk a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .bk__img {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--mint);
  }
  .bk__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .bk a:hover .bk__img :global(img) {
    transform: scale(1.03);
  }
  .bk__meta {
    display: flex;
    gap: 1rem;
    margin: 1rem 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .bk__nazev {
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }
  .bk a:hover .bk__nazev {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .bk__perex {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bk--velka a {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .bk--velka .bk__img {
    aspect-ratio: 3 / 2;
  }
  .bk--velka .bk__nazev {
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .bk--velka .bk__perex {
    font-size: 1.05rem;
    -webkit-line-clamp: 5;
  }
  @media (max-width: 860px) {
    .bk--velka a {
      grid-template-columns: 1fr;
    }
  }
</style>
