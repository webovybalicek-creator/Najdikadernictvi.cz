---
import BlogKarta from './BlogKarta.astro';
import { clanky } from '../lib/blog';

interface Props {
  vynechat?: string;
  pocet?: number;
}
const { vynechat, pocet = 3 } = Astro.props;
const vyber = (await clanky()).filter((c) => c.id !== vynechat).slice(0, pocet);
---

{
  vyber.length > 0 && (
    <section class="tipy">
      <div class="wrap section">
        <div class="sec-head">
          <div>
            <span class="eyebrow">Rady a tipy</span>
            <h2>Než půjdete ke <em>kadeřníkovi</em></h2>
          </div>
          <a class="btn btn--ghost" href="/blog/">Všechny články</a>
        </div>
        <div class="tipy__grid">
          {vyber.map((c) => <BlogKarta c={c} />)}
        </div>
      </div>
    </section>
  )
}

<style>
  .tipy__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: 2rem;
  }
</style>
