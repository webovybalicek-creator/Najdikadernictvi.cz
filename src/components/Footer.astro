---
import { SITE } from '../lib/config';
import Logo from './Logo.astro';

const { reklamy = false } = Astro.props as { reklamy?: boolean };
const rok = new Date().getFullYear();
const p = SITE.provozovatel;
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div class="ftr__brand">
      <Logo />
      <p class="ftr__about">
        Nezávislý katalog kadeřnictví a barbershopů v celém Česku. Otevírací doba, kontakt a cesta na jednom místě,
        i u salonů bez vlastního webu.
      </p>
      <a class="btn btn--ghost" href="/pridat-provozovnu/">Přidat salon</a>
    </div>
    <nav class="ftr__col" aria-label="Hledání">
      <h2 class="ftr__h">Hledání</h2>
      <ul>
        <li><a href="/okoli/">V mém okolí</a></li>
        <li><a href="/okoli/?open=1">Otevřeno teď</a></li>
        <li><a href="/mapa/">Mapa salonů</a></li>
        <li><a href="/oblibene/">Moje oblíbené</a></li>
        <li><a href="/naposledy-prohlizene/">Naposledy prohlížené</a></li>
      </ul>
    </nav>
    <nav class="ftr__col" aria-label="Obsah">
      <h2 class="ftr__h">Čtení</h2>
      <ul>
        <li><a href="/blog/">Rady a tipy</a></li>
        <li><a href="/blog/kdy-maji-kadernictvi-otevreno/">Kdy mají salony otevřeno</a></li>
        <li><a href="/o-webu/">O webu</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
    </nav>
    <nav class="ftr__col" aria-label="Pro salony">
      <h2 class="ftr__h">Pro salony</h2>
      <ul>
        <li><a href="/pridat-provozovnu/">Přidat nebo opravit salon</a></li>
        <li><a href="/pro-salony/">Odznak na váš web</a></li>
      </ul>
    </nav>
  </div>
  <div class="wrap ftr__bottom">
    <p>© {rok} {SITE.domena} · provozuje <a href="/o-webu/#kdo-za-webem-stoji">{p.nazev}</a>, IČO {p.ico}</p>
    <ul class="ftr__pravni">
      <li><a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></li>
      <li><a href="/podminky-uziti/">Podmínky užití</a></li>
      {reklamy && <li><a href="#" data-cookies>Nastavení cookies</a></li>}
    </ul>
    <p class="ftr__zdroje">
      Data o provozovnách: © přispěvatelé <a href="https://www.openstreetmap.org/copyright" rel="noopener">OpenStreetMap</a>, licence ODbL.
      Pohledy z ulice: <a href="https://mapy.com/" rel="noopener">Mapy.com</a>, <a href="https://api.mapy.com/copyright" rel="noopener">© Seznam.cz a.s. a další</a>.
    </p>
  </div>
</footer>

{
  reklamy && (
    <script is:inline>
      // Znovu otevře lištu souhlasu (CMP Googlu z AdSense)
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('[data-cookies]');
        if (!a) return;
        e.preventDefault();
        window.googlefc = window.googlefc || {};
        window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
        window.googlefc.callbackQueue.push({ CONSENT_DATA_READY: function () { window.googlefc.showRevocationMessage(); } });
      });
    </script>
  )
}

<style>
  .ftr {
    margin-top: 48px;
    background: var(--canvas);
    color: var(--slate-ink);
    font-size: 0.875rem;
    --ink: var(--slate-ink);
    border-top: 1px solid var(--line);
  }
  .ftr :global(.logo) {
    color: var(--slate-ink);
    --nuzky-logo: var(--accent);
  }
  @media (hover: hover) {
    .ftr a:hover {
      color: var(--ink);
    }
  }
  .ftr__grid {
    display: grid;
    gap: 2.5rem 2rem;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    padding-top: 64px;
    padding-bottom: 40px;
  }
  .ftr__about {
    color: var(--ink-soft);
    max-width: 30ch;
    margin: 1rem 0 1.25rem;
    font-size: 0.875rem;
    line-height: 1.43;
  }

  .ftr__h {
    font-family: var(--f-text);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0;
    margin: 0.35rem 0 1rem;
    color: var(--ink);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    font-size: 0.875rem;
  }
  ul a {
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 150ms var(--ease-out);
  }
  @media (hover: hover) {
    ul a:hover {
      text-decoration: underline;
    }
  }
  .ftr__bottom {
    border-top: 1px solid var(--line);
    padding-top: 20px;
    padding-bottom: 28px;
    font-size: 0.8rem;
    color: var(--ink-soft);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 2rem;
  }
  .ftr__bottom p {
    margin: 0;
  }
  .ftr__pravni {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    font-size: 0.8rem;
  }
  .ftr__zdroje {
    flex-basis: 100%;
    font-size: 0.72rem;
    opacity: 0.8;
  }
  @media (max-width: 900px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr 1fr;
    }
    .ftr__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .ftr__grid {
      grid-template-columns: 1fr 1fr;
      padding-top: 44px;
    }
    .ftr__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
