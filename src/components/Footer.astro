---
import { KRAJE } from '../lib/kraje';
import { krajUrl } from '../lib/data';
import { SITE } from '../lib/config';
import Logo from './Logo.astro';

const rok = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap ftr__grid">
    <div>
      <Logo />
      <p class="ftr__about">
        Katalog kadeřnictví a barbershopů v celé České republice. Adresa, telefon, otevírací doba a mapa na jednom
        místě.
      </p>
      <a class="btn" href="/pridat-provozovnu/">Přidat provozovnu</a>
    </div>
    <div>
      <h2 class="ftr__h">Kraje</h2>
      <ul class="ftr__kraje">
        {KRAJE.map((k) => <li><a href={krajUrl(k.slug)}>{k.nazev}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="ftr__h">Web</h2>
      <ul>
        <li><a href="/blog/">Rady a tipy</a></li>
        <li><a href="/o-webu/">O webu</a></li>
        <li><a href="/kontakt/">Kontakt</a></li>
        <li><a href="/pridat-provozovnu/">Jste majitel salonu?</a></li>
        <li><a href="/ochrana-osobnich-udaju/">Ochrana osobních údajů</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap ftr__bottom">
    <p>© {rok} {SITE.domena}</p>
    <p>
      Data o provozovnách: © přispěvatelé <a href="https://www.openstreetmap.org/copyright" rel="noopener"
        >OpenStreetMap</a
      >, licence ODbL.
    </p>
  </div>
</footer>

<style>
  .ftr {
    background: var(--bottle);
    color: var(--bottle-ink);
    margin-top: clamp(40px, 6vw, 72px);
    --ink: var(--bottle-ink);
  }
  .ftr :global(.logo) {
    color: var(--bottle-ink);
  }
  .ftr a:hover {
    color: var(--bottle-ink);
    opacity: 0.8;
  }
  .ftr__grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1.3fr 1.4fr 0.8fr;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .ftr__about {
    opacity: 0.85;
    margin: 1rem 0 1.25rem;
    font-size: 0.95rem;
  }
  .ftr .btn {
    background: var(--bottle-ink);
    color: var(--bottle);
    border-color: var(--bottle-ink);
  }
  .ftr__h {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
    display: grid;
    gap: 0.35rem;
  }
  ul a {
    text-decoration: none;
  }
  .ftr__kraje {
    grid-template-columns: 1fr 1fr;
    column-gap: 1.5rem;
  }
  .ftr__bottom {
    border-top: 1px solid rgb(255 255 255 / 0.18);
    padding-top: 20px;
    padding-bottom: 28px;
    font-size: 0.85rem;
    opacity: 0.8;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }
  .ftr__bottom p {
    margin: 0;
  }
  @media (max-width: 820px) {
    .ftr__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
