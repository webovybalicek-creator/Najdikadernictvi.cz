---
// Odznak „Ověřeno majitelem“
interface Props {
  mini?: boolean;
  datum?: string;
}
const { mini = false, datum } = Astro.props;
const kdy = datum ? new Date(datum).toLocaleDateString('cs-CZ', { month: 'long', year: 'numeric' }) : '';
---

<span class:list={['overeno', mini && 'overeno--mini']} title={`Údaje ověřil majitel salonu${kdy ? ` (${kdy})` : ''}`}>
  <svg viewBox="0 0 24 24" aria-hidden="true"
    ><path d="M12 2.5l2.4 1.8 3-.1.9 2.9 2.4 1.8-1 2.8 1 2.8-2.4 1.8-.9 2.9-3-.1L12 21.5l-2.4-1.8-3 .1-.9-2.9-2.4-1.8 1-2.8-1-2.8 2.4-1.8.9-2.9 3 .1z" fill="currentColor"
    ></path><path d="M8.3 12.2l2.5 2.5 5-5" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg
  >
  <span class:list={[mini && 'sr-only']}>Ověřeno majitelem</span>
</span>

<style>
  .overeno {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: #2f6f5a;
    font-size: 0.82rem;
    font-weight: 500;
    vertical-align: middle;
  }
  .overeno svg {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
  }
  .overeno--mini {
    margin-left: 0.35rem;
  }
  .overeno--mini svg {
    width: 1rem;
    height: 1rem;
  }
</style>
