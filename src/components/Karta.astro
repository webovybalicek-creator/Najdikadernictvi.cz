---
import GoogleHodnoceni from './GoogleHodnoceni.astro';
import Vizual from './Vizual.astro';
import Srdce from './Srdce.astro';
import { adresa, url, tyden, TYP_NAZEV, type Provozovna } from '../lib/data';

interface Props {
  p: Provozovna;
  /** Zobrazit „Otevřeno do …“ podle otevírací doby */
  stav?: boolean;
  /** Skrytá karta (vybírá se až v prohlížeči) */
  skryta?: boolean;
  mesto?: string;
}
const { p, stav = false, skryta = false, mesto } = Astro.props;
const t = stav ? tyden(p) : null;
const adr = adresa(p, false);
const misto = p.mesto === 'Praha' && p.cast ? `Praha, ${p.cast}` : p.mesto;
---

<li class="karta" hidden={skryta} data-mesto={mesto}>
  <Srdce p={p} />
  <a href={url(p)}>
    <Vizual p={p} panorama />
    <h3 class="karta__nazev">{p.nazev}</h3>
    {t && <p class="karta__stav" data-oh={JSON.stringify(t)}><span class="stav"></span></p>}
    <p class="karta__adr"><span class="karta__typ">{TYP_NAZEV[p.typ]}</span> · {[adr, misto].filter(Boolean).join(', ')}</p>
    <span class="hod-mini" data-hod-id={p.id}></span>
  </a>
  {p.google && <p class="karta__g"><GoogleHodnoceni p={p} maly /></p>}
</li>

<style>
  .karta {
    position: relative;
  }
  .karta[hidden] {
    display: none;
  }
  .karta__g {
    position: relative;
    z-index: 2;
    margin: 0.35rem 0 0.2rem;
  }
  .karta a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .karta__nazev {
    font-family: var(--f-display);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0;
    margin: 0.75rem 0 0.1rem;
  }
  @media (hover: hover) {
    .karta a:hover .karta__nazev {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
  }
  .karta__stav {
    margin: 0 0 0.1rem;
    font-size: 0.875rem;
  }
  .karta__stav :global(.stav) {
    font-weight: 500;
  }
  .karta__typ {
    display: inline;
    margin: 0;
    font-size: inherit;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .karta__adr {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.43;
    color: var(--ink-soft);
  }
  .karta .hod-mini {
    margin-top: 0.35rem;
  }
  .karta .hod-mini:empty {
    display: none;
  }
</style>
