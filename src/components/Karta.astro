---
import Vizual from './Vizual.astro';
import Srdce from './Srdce.astro';
import { adresa, url, TYP_NAZEV, type Provozovna } from '../lib/data';

interface Props {
  p: Provozovna;
}
const { p } = Astro.props;
const adr = adresa(p, false);
const misto = p.mesto === 'Praha' && p.cast ? `Praha, ${p.cast}` : p.mesto;
---

<li class="karta">
  <Srdce p={p} />
  <a href={url(p)}>
    <Vizual p={p} />
    <span class="karta__typ">{TYP_NAZEV[p.typ]}</span>
    <h3 class="karta__nazev">{p.nazev}</h3>
    <p class="karta__adr">{[adr, misto].filter(Boolean).join(', ')}</p>
    <span class="hod-mini" data-hod-id={p.id}><span class="hv" style="--p:0%"></span><span class="hod-mini__nic">Zatím bez hodnocení</span></span>
  </a>
</li>

<style>
  .karta {
    position: relative;
  }
  .karta a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .karta__typ {
    display: block;
    margin-top: 0.9rem;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .karta__nazev {
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.2;
    margin: 0.25rem 0 0.2rem;
  }
  .karta a:hover .karta__nazev {
    text-decoration: underline;
  }
  .karta .hod-mini {
    margin-top: 0.4rem;
  }
  .karta__adr {
    margin: 0;
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
</style>
