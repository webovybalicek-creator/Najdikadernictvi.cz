---
// Magazínový výpis článků: hlavní článek + sloupec dalších + tmavý pás se záložkami podle kategorií
import { Picture, getImage } from 'astro:assets';
import { clanky, clanekUrl, kategorieUrl, casCteni, KATEGORIE, kategorieSlug, type Clanek } from '../lib/blog';

interface Props {
  /** Zobrazit nadpis sekce (na úvodu webu ano, na blogu ne) */
  nadpis?: boolean;
}
const { nadpis = true } = Astro.props;

const vse = await clanky();
const hlavni = vse.find((c) => c.data.hlavni) ?? vse[0];
const bocni = vse.filter((c) => c.id !== hlavni.id).slice(0, 4);
const nahore = new Set([hlavni.id, ...bocni.map((c) => c.id)]);
const zalozky = KATEGORIE.map((k) => ({
  k,
  slug: kategorieSlug(k),
  // v pásu přednostně články, které nejsou nahoře
  clanky: [
    ...vse.filter((c) => c.data.kategorie === k && !nahore.has(c.id)),
    ...vse.filter((c) => c.data.kategorie === k && nahore.has(c.id)),
  ].slice(0, 3),
})).filter((z) => z.clanky.length > 0);

// Data všech článků pro náhodné pořadí v prohlížeči (server vykreslí výchozí výběr kvůli vyhledávačům)
const obr = async (src: Clanek['data']['obrazek'], w: number, h: number) => {
  const [a, b] = await Promise.all([
    getImage({ src, width: w, height: h, fit: 'cover', format: 'avif' }),
    getImage({ src, width: w, height: h, fit: 'cover', format: 'webp' }),
  ]);
  return [a.src, b.src];
};
const pool = await Promise.all(
  vse.map(async (c) => ({
    u: clanekUrl(c),
    t: c.data.title,
    p: c.data.perex,
    k: c.data.kategorie,
    ku: kategorieUrl(c.data.kategorie),
    ks: kategorieSlug(c.data.kategorie),
    m: casCteni(c),
    alt: c.data.obrazekAlt,
    l: await obr(c.data.obrazek, 1000, 625),
    b: await obr(c.data.obrazek, 420, 315),
    s: await obr(c.data.obrazek, 640, 400),
  })),
);
---

<section class="mag" data-mag>
  <script type="application/json" data-mag-pool set:html={JSON.stringify(pool)} />
  <div class="wrap">
    {
      nadpis && (
        <div class="sec-head">
          <div>
            <span class="eyebrow">Magazín</span>
            <h2>
              Rady a inspirace
            </h2>
          </div>
          <a class="btn btn--ghost" href="/blog/">
            Všechny články
          </a>
        </div>
      )
    }

    <div class="mag__top">
      <article class="lead" data-mag-lead>
        <a href={clanekUrl(hlavni)}>
          <h3 class="lead__nazev">{hlavni.data.title}</h3>
          <div class="lead__img">
            <Picture formats={['avif', 'webp']}
              src={hlavni.data.obrazek}
              alt={hlavni.data.obrazekAlt}
              widths={[480, 800, 1100]}
              sizes="(max-width: 900px) 100vw, 55vw"
            />
          </div>
          <p class="lead__perex">{hlavni.data.perex}</p>
        </a>
        <p class="meta">
          <a href={kategorieUrl(hlavni.data.kategorie)}>{hlavni.data.kategorie}</a>
          <span>{casCteni(hlavni)} min čtení</span>
        </p>
      </article>

      <ul class="bocni" data-mag-bocni>
        {
          bocni.map((c) => (
            <li>
              <article>
                <div class="bocni__txt">
                  <h3>
                    <a href={clanekUrl(c)}>{c.data.title}</a>
                  </h3>
                  <p class="meta">
                    <a href={kategorieUrl(c.data.kategorie)}>{c.data.kategorie}</a>
                  </p>
                </div>
                <a class="bocni__img" href={clanekUrl(c)} tabindex="-1" aria-hidden="true">
                  <Picture formats={['avif', 'webp']} src={c.data.obrazek} alt="" widths={[240, 420]} sizes="(max-width: 600px) 40vw, 14rem" />
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="wrap">
    <div class="pas" data-pas>
      <h3 class="pas__h">Podle témat</h3>
      <div class="pas__tabs" role="tablist">
        {
          zalozky.map((z, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${z.slug}`}
              aria-controls={`panel-${z.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {z.k}
            </button>
          ))
        }
      </div>
      {
        zalozky.map((z, i) => (
          <div class="pas__panel" data-kat={z.slug} data-kat-nazev={z.k} data-kat-url={kategorieUrl(z.k)} role="tabpanel" id={`panel-${z.slug}`} aria-labelledby={`tab-${z.slug}`} hidden={i !== 0}>
            {z.clanky.map((c) => (
              <article>
                <a href={clanekUrl(c)}>
                  <div class="pas__img">
                    <Picture formats={['avif', 'webp']} src={c.data.obrazek} alt={c.data.obrazekAlt} widths={[360, 640]} sizes="(max-width: 760px) 100vw, 30vw" />
                  </div>
                  <h4>{c.data.title}</h4>
                </a>
                <p class="meta">
                  <span>{casCteni(c)} min čtení</span>
                  <a href={kategorieUrl(c.data.kategorie)}>{c.data.kategorie}</a>
                </p>
              </article>
            ))}
          </div>
        ))
      }
      <p class="pas__vice">
        <a class="btn btn--ghost" href={zalozky[0] ? kategorieUrl(zalozky[0].k) : '/blog/'} data-mag-vice>
          Další články: <span data-mag-vice-k>{zalozky[0]?.k}</span> <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </div>
</section>

<script>
  // Náhodný výběr článků při každém načtení
  type P = { u: string; t: string; p: string; k: string; ku: string; ks: string; m: number; alt: string; l: string[]; b: string[]; s: string[] };
  const esc = (x: string) => String(x).replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
  const pic = (src: string[], alt: string, eager = false) =>
    `<picture><source type="image/avif" srcset="${src[0]}"><img src="${src[1]}" alt="${esc(alt)}" ${eager ? '' : 'loading="lazy" '}decoding="async"></picture>`;
  const zamichej = <T,>(a: T[]) => {
    const b = [...a];
    for (let i = b.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [b[i], b[j]] = [b[j], b[i]];
    }
    return b;
  };
  document.querySelectorAll<HTMLElement>('[data-mag]').forEach((mag) => {
    const el = mag.querySelector('[data-mag-pool]');
    if (!el) return;
    const pool = zamichej(JSON.parse(el.textContent!) as P[]);
    // scoped styly Astra: nové prvky dostanou stejný atribut data-astro-cid-* jako sekce
    const cid = [...mag.attributes].map((a) => a.name).find((n) => n.startsWith('data-astro-cid-'));
    const oznac = (root: Element) => cid && root.querySelectorAll('*').forEach((x) => x.setAttribute(cid, ''));
    if (pool.length < 5) return;
    const [hl, ...zbytek] = pool;
    const lead = mag.querySelector<HTMLElement>('[data-mag-lead]');
    if (lead) {
      lead.innerHTML = `<a href="${hl.u}"><h3 class="lead__nazev">${esc(hl.t)}</h3><div class="lead__img">${pic(hl.l, hl.alt, true)}</div><p class="lead__perex">${esc(hl.p)}</p></a>
        <p class="meta"><a href="${hl.ku}">${esc(hl.k)}</a><span>${hl.m} min čtení</span></p>`;
      oznac(lead);
    }
    const bocni = zbytek.slice(0, 4);
    const ul = mag.querySelector<HTMLElement>('[data-mag-bocni]');
    if (ul) {
      ul.innerHTML = bocni
        .map(
          (c) => `<li><article><div class="bocni__txt"><h3><a href="${c.u}">${esc(c.t)}</a></h3><p class="meta"><a href="${c.ku}">${esc(c.k)}</a></p></div>
          <a class="bocni__img" href="${c.u}" tabindex="-1" aria-hidden="true">${pic(c.b, '')}</a></article></li>`,
        )
        .join('');
      oznac(ul);
    }
    const nahore = new Set([hl.u, ...bocni.map((c) => c.u)]);
    mag.querySelectorAll<HTMLElement>('[data-kat]').forEach((panel) => {
      const v = pool.filter((c) => c.ks === panel.dataset.kat);
      const vyber = [...v.filter((c) => !nahore.has(c.u)), ...v.filter((c) => nahore.has(c.u))].slice(0, 3);
      panel.innerHTML = vyber
        .map(
          (c) => `<article><a href="${c.u}"><div class="pas__img">${pic(c.s, c.alt)}</div><h4>${esc(c.t)}</h4></a>
          <p class="meta"><span>${c.m} min čtení</span><a href="${c.ku}">${esc(c.k)}</a></p></article>`,
        )
        .join('');
      oznac(panel);
    });
  });

  document.querySelectorAll<HTMLElement>('[data-pas]').forEach((pas) => {
    const tabs = [...pas.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const vyber = (t: HTMLButtonElement) => {
      tabs.forEach((x) => {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        const panel = pas.querySelector<HTMLElement>(`#${x.getAttribute('aria-controls')}`)!;
        panel.hidden = !on;
        if (on) {
          const vice = pas.querySelector<HTMLAnchorElement>('[data-mag-vice]');
          if (vice) {
            vice.href = panel.dataset.katUrl!;
            vice.querySelector('[data-mag-vice-k]')!.textContent = panel.dataset.katNazev!;
          }
        }
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => vyber(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        const n = tabs[(i + d + tabs.length) % tabs.length];
        n.focus();
        vyber(n);
      });
    });
  });
</script>

<style>
  .mag {
    padding-block: 48px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.6rem 0 0;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .meta a {
    color: var(--ink);
    text-decoration: none;
  }
  @media (hover: hover) {
    .meta a:hover {
      text-decoration: underline;
    }
  }

  /* Horní část */
  .mag__top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
  }
  .lead > a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  article.lead {
    color: var(--ink);
    font-size: 1rem;
  }
  .lead__nazev {
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
  }
  .lead > a:hover .lead__nazev {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .lead__img {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--mint);
  }
  .lead__img :global(img),
  .bocni__img :global(img),
  .pas__img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out);
  }
  @media (hover: hover) {
    .lead > a:hover :global(img),
    .pas article a:hover :global(img) {
      transform: scale(1.025);
    }
  }
  .lead__perex {
    max-width: none;
    margin: 1.1rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .bocni {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    align-content: space-between;
  }
  .bocni li + li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .bocni article {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(7rem, 30%, 13rem);
    gap: 1.25rem;
    align-items: start;
  }
  .bocni h3 {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin: 0;
    letter-spacing: 0;
  }
  .bocni h3 a {
    text-decoration: none;
  }
  .bocni h3 a:hover {
    text-decoration: underline;
  }
  .bocni__img {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--mint);
  }

  /* Pás podle témat: světlý, oddělený linkou */
  .pas {
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--line);
  }
  .pas__h {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    margin: 0 0 0.9rem;
  }
  .pas__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.75rem;
  }
  .pas__tabs button {
    appearance: none;
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.6rem 0;
    margin-bottom: -1px;
    font: 500 0.875rem/1.2 var(--f-text);
    color: var(--ink-soft);
    cursor: pointer;
    transition:
      color 150ms var(--ease-out),
      border-color 150ms var(--ease-out);
  }
  @media (hover: hover) {
    .pas__tabs button:hover {
      color: var(--ink);
    }
  }
  .pas__tabs button[aria-selected='true'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  .pas__panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.75rem;
  }
  .pas__panel[hidden] {
    display: none;
  }
  .pas article > a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .pas__img {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--mint);
  }
  .pas h4 {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.3;
    margin: 0.9rem 0 0;
  }
  @media (hover: hover) {
    .pas article > a:hover h4 {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }
  }
  .pas__vice {
    max-width: none;
    margin: 2rem 0 0;
  }

  @media (max-width: 900px) {
    .mag__top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 760px) {
    .pas__panel {
      grid-template-columns: 1fr;
    }
    .pas__panel article + article {
      padding-top: 1.5rem;
      border-top: 1px solid var(--line);
    }
  }
</style>
