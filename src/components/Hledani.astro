---
// Vyhledávání podle města nebo názvu salonu. Index se načte až při prvním psaní.
---

<form class="srch" role="search" action="/hledat/" method="get" data-hledani>
  <label for="q" class="sr-only">Město nebo název salonu</label>
  <input
    id="q"
    name="q"
    type="search"
    autocomplete="off"
    placeholder="Město nebo název salonu, např. Brno"
    aria-controls="srch-vysledky"
    aria-autocomplete="list"
  />
  <a class="srch__geo" href="/okoli/" title="Salony v mém okolí">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
      ><path
        d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"></path><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.5"
      ></circle></svg
    >
    <span>V mém okolí</span>
  </a>
  <button class="btn" type="submit">Hledat</button>
  <div id="srch-vysledky" class="srch__res" role="listbox" hidden></div>
</form>

<script>
  type Mesto = [string, string, number, string]; // název, url, počet, kraj
  type Salon = [string, string, string, number, number, string?]; // název, url, město, lat, lon, vlastní fotka
  let index: { m: Mesto[]; s: Salon[] } | null = null;
  const norm = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase();

  let nacitani: Promise<{ m: Mesto[]; s: Salon[] }> | null = null;
  async function nacti() {
    if (index) return index;
    nacitani ??= fetch('/hledat.json')
      .then((r) => r.json())
      .then((d: { m: Mesto[]; s: [string, string, number, number, number, string?][] }) => ({
        m: d.m,
        // rozbalení kompaktního formátu: [název, slug, index města, …] → [název, url, město, …]
        s: d.s.map(([n, slug, i, la, lo, f]) => [n, `${d.m[i][1]}${slug}/`, d.m[i][0], la, lo, f] as Salon),
      }));
    index = await nacitani;
    return index;
  }

  function vyhledej(q: string, idx: { m: Mesto[]; s: Salon[] }) {
    const t = norm(q).split(/\s+/).filter(Boolean);
    const shoda = (txt: string) => {
      const n = norm(txt);
      return t.every((w) => n.includes(w));
    };
    const mesta = idx.m
      .filter((m) => shoda(m[0]))
      .sort((a, b) => Number(norm(b[0]).startsWith(t[0])) - Number(norm(a[0]).startsWith(t[0])) || b[2] - a[2])
      .slice(0, 6);
    const salony = idx.s.filter((s) => shoda(`${s[0]} ${s[2]}`)).slice(0, 8);
    return { mesta, salony };
  }

  document.querySelectorAll<HTMLFormElement>('[data-hledani]').forEach((form) => {
    const input = form.querySelector('input')!;
    const box = form.querySelector<HTMLElement>('.srch__res')!;
    let token = 0;

    const render = async () => {
      const q = input.value.trim();
      const my = ++token;
      if (q.length < 2) {
        box.hidden = true;
        return;
      }
      const idx = await nacti();
      if (my !== token) return;
      const { mesta, salony } = vyhledej(q, idx);
      if (!mesta.length && !salony.length) {
        box.innerHTML = '<p class="srch__empty">Nic jsme nenašli. Zkuste jiný název nebo jen město.</p>';
      } else {
        const esc = (s: string) => s.replace(/[&<>"]/g, (c) => `&#${c.charCodeAt(0)};`);
        box.innerHTML =
          (mesta.length
            ? `<p class="srch__h">Města</p>` +
              mesta
                .map(
                  (m) =>
                    `<a role="option" href="${m[1]}"><span>${esc(m[0])}</span><small>${esc(m[3])} · ${m[2]}</small></a>`,
                )
                .join('')
            : '') +
          (salony.length
            ? `<p class="srch__h">Salony</p>` +
              salony
                .map((s) => {
                  const mono = esc(s[0].replace(/^(kadeřnictví|barbershop|barber|salon|studio)\s+/i, '').slice(0, 2).toUpperCase());
                  const foto = s[5] ?? `/api/panorama.php?lat=${s[3]}&lon=${s[4]}&s=maly&v=2`;
                  return `<a role="option" class="srch__salon" href="${s[1]}"><span class="srch__th"><b>${mono}</b><img src="${foto}" alt="" loading="lazy" onload="this.classList.add('ok')" onerror="this.parentNode.classList.add('bez');this.remove()"></span><span class="srch__txt"><span>${esc(s[0])}</span><small>${esc(s[2])}</small></span></a>`;
                })
                .join('') +
              `<p class="srch__atr">Náhledy z ulice © Mapy.com</p>`
            : '');
      }
      box.hidden = false;
    };

    // náhledy fotek se načítají až když uživatel chvíli nepíše (šetří kredity Mapy.com)
    let casovac = 0;
    input.addEventListener('input', () => {
      clearTimeout(casovac);
      casovac = window.setTimeout(render, 220);
    });
    input.addEventListener('focus', () => {
      nacti();
      if (input.value.trim().length >= 2) render();
    });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const idx = await nacti();
      const { mesta, salony } = vyhledej(input.value.trim(), idx);
      const prvni = mesta[0]?.[1] ?? salony[0]?.[1];
      if (prvni) location.href = prvni;
      else render();
    });
    document.addEventListener('click', (e) => {
      if (!form.contains(e.target as Node)) box.hidden = true;
    });
    form.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') box.hidden = true;
      if (e.key === 'ArrowDown') {
        const links = [...box.querySelectorAll<HTMLAnchorElement>('a')];
        const i = links.indexOf(document.activeElement as HTMLAnchorElement);
        links[Math.min(i + 1, links.length - 1)]?.focus();
        e.preventDefault();
      }
      if (e.key === 'ArrowUp') {
        const links = [...box.querySelectorAll<HTMLAnchorElement>('a')];
        const i = links.indexOf(document.activeElement as HTMLAnchorElement);
        if (i <= 0) input.focus();
        else links[i - 1].focus();
        e.preventDefault();
      }
    });
  });
</script>

<style>
  .srch {
    --srch-h: 3.1rem;
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    max-width: 40rem;
    padding: 0.35rem;
    background: #fff;
    border: 1px solid #d9d9de;
    border-radius: 12px;
    box-shadow: 0 1px 2px rgb(17 17 19 / 0.04);
    transition:
      border-color 150ms var(--ease-out),
      box-shadow 150ms var(--ease-out);
  }
  .srch:focus-within {
    border-color: var(--ink);
    box-shadow: 0 0 0 3px rgb(17 17 19 / 0.07);
  }
  input {
    flex: 1;
    min-width: 0;
    height: var(--srch-h);
    font: 400 1.02rem/1.2 var(--f-text);
    padding: 0 1em 0 0.85em;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--ink);
  }
  input::placeholder {
    color: #8e8e94;
  }
  input:focus-visible {
    outline: none;
  }
  .btn {
    height: var(--srch-h);
    padding: 0 1.5em;
    justify-content: center;
    border-radius: 8px;
  }
  .srch__geo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    padding: 0 1.1em;
    height: var(--srch-h);
    border-radius: 8px;
    background: var(--accent);
    font-size: 0.92rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    color: #fff;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .srch__geo svg {
    stroke-width: 2;
  }
  .srch__geo:active {
    transform: scale(0.97);
  }
  @media (hover: hover) {
    .srch__geo:hover {
      background: #c94812;
      color: #fff;
    }
  }
  @media (max-width: 560px) {
    .srch {
      flex-wrap: wrap;
      border-radius: 12px;
    }
    input {
      flex-basis: 100%;
    }
    .srch__geo,
    .btn {
      flex: 1;
      justify-content: center;
    }

  }
  .srch__res {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 20;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 12px 32px rgb(17 17 19 / 0.12);
    padding: 0.4rem;
    transform-origin: top center;
    animation: srch-in 160ms var(--ease-out);
    max-height: 70vh;
    overflow: auto;
  }
  .srch__res :global(a) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .srch__res :global(a:hover),
  .srch__res :global(a:focus-visible) {
    background: var(--mint);
    color: var(--ink);
    outline: none;
  }
  .srch__res :global(.srch__salon) {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 0.75rem;
  }
  .srch__res :global(.srch__th) {
    position: relative;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 8px;
    overflow: hidden;
    background: #f1f1f3;
    display: grid;
    place-items: center;
  }
  .srch__res :global(.srch__th b) {
    display: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .srch__res :global(.srch__th.bez) {
    background: var(--mint);
  }
  .srch__res :global(.srch__th.bez b) {
    display: block;
  }
  .srch__res :global(.srch__th img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .srch__res :global(.srch__th img.ok) {
    opacity: 1;
  }
  .srch__res :global(.srch__txt) {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .srch__res :global(.srch__txt small) {
    margin: 0;
  }
  .srch__res :global(.srch__atr) {
    margin: 0.25rem 0.7rem 0.2rem;
    font-size: 0.68rem;
    color: var(--ink-soft);
    text-align: right;
  }
  .srch__res :global(small) {
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .srch__res :global(.srch__h) {
    margin: 0.4rem 0.7rem 0.2rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  @keyframes srch-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .srch__res :global(.srch__empty) {
    margin: 0.6rem 0.7rem;
    color: var(--ink-soft);
  }
</style>
