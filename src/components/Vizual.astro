---
// Generovaný vizuál salonu: monogram + vzor podle typu. Používá se, dokud nemáme vlastní fotku.
import type { Provozovna } from '../lib/data';

interface Props {
  p: Provozovna;
  velky?: boolean;
  /** Načíst „pohled z ulice“ z Mapy.com přes /api/panorama.php (jen detail salonu, kvůli povinné atribuci) */
  panorama?: boolean;
}
const { p, velky = false, panorama = false } = Astro.props;
// Vlastní fotka od majitele má přednost před pohledem z ulice
const vlastni = p.fotky?.[0];
const panoUrl = vlastni ?? `/api/panorama.php?lat=${p.lat}&lon=${p.lon}&s=${velky ? 'velky' : 'maly'}&v=2`;

// Neutrální šedé tóny, ať monogram nepůsobí jako barevná dekorace
const PALETA = [
  ['#f7f7f7', '#222222'],
  ['#f2f2f2', '#3d3d3d'],
  ['#ebebeb', '#222222'],
  ['#f7f7f7', '#6a6a6a'],
];
let h = 0;
for (const ch of p.id + p.nazev) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const [bg, fg] = PALETA[h % PALETA.length];

const slova = p.nazev
  .replace(/^(kadeřnictví|kadernictvi|barbershop|barber shop|barber|salon|studio|holičství)\s+/i, '')
  .split(/[\s\-&]+/)
  .filter((w) => /^[\p{L}\d]/u.test(w));
const mono = (slova.length > 1 ? slova[0][0] + slova[1][0] : (slova[0] ?? p.nazev).slice(0, 2)).toUpperCase();
const id = `v-${p.id}`;
---

<div class:list={['viz', velky && 'viz--velky', (panorama || vlastni) && 'viz--foto']} style={`--bg:${bg};--fg:${fg}`} aria-hidden="true">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
    <defs>
      {
        p.typ === 'barber' ? (
          <pattern id={id} width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
            <rect width="40" height="40" fill={bg} />
            <rect width="1" height="40" fill={fg} opacity="0.12" />
          </pattern>
        ) : (
          <pattern id={id} width="18" height="44" patternUnits="userSpaceOnUse">
            <rect width="18" height="44" fill={bg} />
            <rect x="8" y="0" width="1" height="26" fill={fg} opacity="0.1" />
          </pattern>
        )
      }
    </defs>
    <rect width="400" height="300" fill={`url(#${id})`}></rect>
  </svg>
  <span class="viz__mono">{mono}</span>
  {
    (panorama || vlastni) && (
      <img
        class:list={['viz__foto', vlastni && 'viz__foto--vlastni']}
        src={panoUrl}
        alt=""
        loading="lazy"
        decoding="async"
        onload="this.classList.add('ok')"
        onerror="this.parentNode.classList.remove('viz--foto');this.remove()"
      />
    )
  }
  {panorama && !vlastni && <span class="viz__atr" aria-hidden="true">© Mapy.com</span>}
</div>

<style>
  .viz {
    position: relative;
    aspect-ratio: 20 / 19;
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .viz svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .viz__mono {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--f-display);
    font-weight: 500;
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .viz__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    opacity: 0;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.5s var(--ease-out);
  }
  @media (hover: hover) {
    :global(a:hover) > .viz .viz__foto.ok {
      transform: scale(1.04);
    }
  }
  .viz__foto--vlastni {
    object-position: center;
  }
  .viz__foto.ok {
    opacity: 1;
  }
  /* Dokud se fotka načítá: jen neutrální šedé pozadí, bez monogramu (ten jen když fotka není) */
  .viz--foto {
    background: var(--canvas);
  }
  .viz--velky {
    aspect-ratio: 4 / 3;
  }
  .viz--foto svg,
  .viz--foto .viz__mono {
    display: none;
  }
  .viz--velky .viz__mono {
    font-size: clamp(4rem, 12vw, 7.5rem);
  }
</style>
