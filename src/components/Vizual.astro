---
// Generovaný vizuál salonu: monogram + vzor podle typu. Používá se, dokud nemáme vlastní fotku.
import type { Provozovna } from '../lib/data';

interface Props {
  p: Provozovna;
  velky?: boolean;
}
const { p, velky = false } = Astro.props;

const PALETA = [
  ['#1e4a3c', '#f1f5f2'],
  ['#2b5f8a', '#eef4f9'],
  ['#7a3b2e', '#f8efe9'],
  ['#3d3a5c', '#f0eff6'],
  ['#5c4a1e', '#f7f2e6'],
  ['#245a5a', '#ebf5f5'],
];
let h = 0;
for (const ch of p.id + p.nazev) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const [bg, fg] = PALETA[h % PALETA.length];

const slova = p.nazev
  .replace(/^(kadeřnictví|kadernictvi|barbershop|barber shop|barber|salon|studio|holičství)\s+/i, '')
  .split(/[\s\-&]+/)
  .filter((w) => /^[\p{L}\d]/u.test(w));
const mono = (slova.length > 1 ? slova[0][0] + slova[1][0] : (slova[0] ?? p.nazev).slice(0, 2)).toUpperCase();
const id = `v-${p.id}`;
---

<div class:list={['viz', velky && 'viz--velky']} style={`--bg:${bg};--fg:${fg}`} aria-hidden="true">
  <svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice">
    <defs>
      {
        p.typ === 'barber' ? (
          <pattern id={id} width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(-35)">
            <rect width="40" height="40" fill={bg} />
            <rect width="12" height="40" fill={fg} opacity="0.09" />
            <rect x="20" width="6" height="40" fill={fg} opacity="0.05" />
          </pattern>
        ) : (
          <pattern id={id} width="18" height="44" patternUnits="userSpaceOnUse">
            <rect width="18" height="44" fill={bg} />
            <rect x="6" y="0" width="5" height="30" rx="2.5" fill={fg} opacity="0.07" />
          </pattern>
        )
      }
    </defs>
    <rect width="400" height="300" fill={`url(#${id})`}></rect>
  </svg>
  <span class="viz__mono">{mono}</span>
</div>

<style>
  .viz {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--bg);
    color: var(--fg);
    overflow: hidden;
    border-radius: var(--radius);
  }
  .viz svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .viz__mono {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--f-display);
    font-weight: 900;
    font-size: clamp(3rem, 9vw, 5rem);
    letter-spacing: 0.02em;
    line-height: 1;
  }
  .viz--velky .viz__mono {
    font-size: clamp(4rem, 14vw, 9rem);
  }
</style>
