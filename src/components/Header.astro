---
import Logo from './Logo.astro';
// Na úvodní stránce je hlavička průhledná přes gradient, po posunu stránky dostane bílé pozadí
const pruhledna = Astro.url.pathname === '/';
---

<header class:list={['hdr', pruhledna && 'hdr--pruhledna']} data-hdr>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Najdi kadeřnictví – úvod"><Logo /></a>
    <nav aria-label="Hlavní menu">
      <ul>
        <li class="nav-skryt-m"><a href="/mapa/">Mapa</a></li>
        <li class="nav-skryt-m"><a href="/blog/">Rady a tipy</a></li>
        <li class="nav-skryt-m"><a href="/o-webu/">O webu</a></li>
        <li>
          <a href="/oblibene/" class="hdr__obl" aria-label="Oblíbené salony">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 20.5s-7.5-4.6-9.3-9.4C1.4 7.6 3.6 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4c3.6 0 5.8 3.6 4.5 7.1-1.8 4.8-9.3 9.4-9.3 9.4z"
              ></path></svg
            >
            <span class="hdr__obl-pocet" data-pocet-oblibenych hidden></span>
          </a>
        </li>
        <li class="nav-skryt-m"><a href="/pridat-provozovnu/" class="btn btn--ghost hdr__cta">Přidat salon</a></li>
        <li class="nav-jen-m">
          <button type="button" class="hdr__burger" aria-expanded="false" aria-controls="mobilni-menu" data-burger>
            <span class="sr-only">Menu</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </li>
      </ul>
    </nav>
    <div class="mmenu" id="mobilni-menu" data-mmenu hidden>
      <ul>
        <li><a href="/mapa/">Mapa salonů</a></li>
        <li><a href="/okoli/">V mém okolí</a></li>
        <li><a href="/blog/">Rady a tipy</a></li>
        <li><a href="/oblibene/">Oblíbené</a></li>
        <li><a href="/naposledy-prohlizene/">Naposledy prohlížené</a></li>
        <li><a href="/o-webu/">O webu</a></li>
      </ul>
      <a class="btn" href="/pridat-provozovnu/">Přidat salon</a>
    </div>
  </div>
</header>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr].hdr--pruhledna');
  if (hdr) {
    const obnov = () => hdr.classList.toggle('hdr--posunuta', scrollY > 8);
    obnov();
    addEventListener('scroll', obnov, { passive: true });
  }
  const btn = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mmenu]');
  if (btn && menu) {
    const nastav = (on: boolean) => {
      menu.hidden = !on;
      btn.setAttribute('aria-expanded', String(on));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      nastav(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !menu.contains(e.target as Node)) nastav(false);
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && nastav(false));
  }
</script>

<style>
  .hdr {
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  /* Úvodní stránka: hlavička bez linky, po posunu dostane bílé pozadí */
  .hdr--pruhledna {
    position: fixed;
    left: 0;
    right: 0;
    background: transparent;
    border-bottom-color: transparent;
    backdrop-filter: none;
    transition: background 0.25s, border-color 0.25s, backdrop-filter 0.25s;
  }
  .hdr--pruhledna.hdr--posunuta {
    background: rgb(255 255 255 / 0.85);
    border-bottom-color: var(--line);
    backdrop-filter: saturate(1.4) blur(10px);
  }
  .hdr--pruhledna .hdr__burger:not([aria-expanded='true']) {
    background: rgb(255 255 255 / 0.6);
  }
  .nav-jen-m {
    display: none;
  }
  .hdr__burger {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-out);
  }
  .hdr__burger:active {
    transform: scale(0.95);
  }
  .hdr__burger svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }
  .hdr__burger[aria-expanded='true'] {
    background: var(--bottle);
    border-color: var(--bottle);
    color: var(--bottle-ink);
  }
  .mmenu {
    position: absolute;
    top: 100%;
    left: 16px;
    right: 16px;
    padding: 0.5rem 1.25rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 16px 40px rgb(17 17 19 / 0.14);
    transform-origin: top right;
    animation: mmenu-in 180ms var(--ease-out);
  }
  @keyframes mmenu-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .mmenu[hidden] {
    display: none;
  }
  .mmenu ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  .mmenu li a {
    display: block;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
    text-decoration: none;
    color: var(--ink);
  }
  .mmenu .btn {
    display: block;
    text-align: center;
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 68px;
  }
  .hdr__logo {
    text-decoration: none;
    color: var(--ink);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    align-items: center;
    font-size: 0.92rem;
    font-weight: 500;
  }
  nav a {
    text-decoration: none;
    white-space: nowrap;
  }
  @media (hover: hover) {
    nav a:not(.btn):hover {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }
  .hdr__obl {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
  }
  .hdr__obl svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }
  .hdr__obl-pocet {
    position: absolute;
    top: -0.1rem;
    right: -0.25rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding: 0 0.25rem;
    border-radius: 999px;
    background: #b0574a;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.05rem;
    text-align: center;
    letter-spacing: 0;
  }
  .hdr__cta {
    padding: 0.6em 1.15em;
    font-size: 0.88rem;
  }
  @media (max-width: 760px) {
    .nav-skryt-m {
      display: none;
    }
    .nav-jen-m {
      display: list-item;
    }
    nav ul {
      gap: 0.9rem;
    }
  }
  @media (max-width: 400px) {
    .hdr__logo :global(.logo) {
      font-size: 1.2rem;
    }
    nav ul {
      gap: 0.6rem;
    }
  }
  @media (max-width: 360px) {
    .hdr__cta-txt {
      display: none;
    }
    .hdr__cta::before {
      content: '+';
      font-size: 1.1rem;
      line-height: 1;
    }
  }
  @media (max-width: 440px) {
    .hdr__cta-cele {
      display: none;
    }
    .hdr__cta {
      padding: 0.6em 0.8em;
    }
  }
</style>
