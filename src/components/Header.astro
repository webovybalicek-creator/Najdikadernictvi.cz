---
import Logo from './Logo.astro';
---

<header class="hdr">
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Najdi kadeřnictví – úvod"><Logo /></a>
    <nav aria-label="Hlavní menu">
      <ul>
        <li><a href="/kraje/">Kraje</a></li>
        <li><a href="/blog/">Rady a tipy</a></li>
        <li><a href="/o-webu/">O webu</a></li>
        <li><a href="/pridat-provozovnu/" class="btn btn--ghost hdr__cta">Přidat salon</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .hdr {
    background: var(--paper);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }
  .hdr__logo {
    text-decoration: none;
    color: var(--ink);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: clamp(1rem, 3vw, 2.25rem);
    align-items: center;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  nav a {
    text-decoration: none;
    white-space: nowrap;
  }
  nav a:not(.btn):hover {
    text-decoration: underline;
  }
  .hdr__cta {
    padding: 0.6em 1.1em;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  @media (max-width: 640px) {
    nav li:nth-child(1),
    nav li:nth-child(3) {
      display: none;
    }
  }
  @media (max-width: 420px) {
    nav li:nth-child(2) {
      display: none;
    }
  }
</style>
