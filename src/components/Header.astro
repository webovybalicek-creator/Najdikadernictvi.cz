---
import Logo from './Logo.astro';
// Bílá hlavička (Airbnb): logo vlevo, odkazy uprostřed, kruhová tlačítka vpravo
---

<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Najdi kadeřnictví – úvod"><Logo /></a>
    <nav aria-label="Hlavní menu">
      <ul>
        <li class="nav-skryt-m"><a href="/kdy-se-ostriham/">Kdy se ostříhám</a></li>
        <li class="nav-skryt-m"><a href="/mapa/">Mapa</a></li>
        <li class="nav-skryt-m"><a href="/blog/">Rady a tipy</a></li>
        <li class="nav-skryt-m"><a href="/o-webu/">O webu</a></li>
        <li>
          <a href="/oblibene/" class="hdr__obl kruh" aria-label="Oblíbené salony">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 20.5s-7.5-4.6-9.3-9.4C1.4 7.6 3.6 4 7.2 4c2 0 3.6 1.1 4.8 2.8C13.2 5.1 14.8 4 16.8 4c3.6 0 5.8 3.6 4.5 7.1-1.8 4.8-9.3 9.4-9.3 9.4z"
              ></path></svg
            >
            <span class="hdr__obl-pocet" data-pocet-oblibenych hidden></span>
          </a>
        </li>
        <li class="nav-skryt-m"><a href="/pridat-provozovnu/" class="hdr__cta">Přidat salon</a></li>
        <li class="nav-jen-m">
          <button type="button" class="hdr__burger kruh" aria-expanded="false" aria-controls="mobilni-menu" data-burger>
            <span class="sr-only">Menu</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        </li>
      </ul>
    </nav>
    <div class="mmenu" id="mobilni-menu" data-mmenu hidden>
      <ul>
        <li><a href="/kdy-se-ostriham/">Kdy se ostříhám</a></li>
        <li><a href="/mapa/">Mapa salonů</a></li>
        <li><a href="/okoli/">V mém okolí</a></li>
        <li><a href="/blog/">Rady a tipy</a></li>
        <li><a href="/oblibene/">Oblíbené</a></li>
        <li><a href="/naposledy-prohlizene/">Naposledy prohlížené</a></li>
        <li><a href="/o-webu/">O webu</a></li>
      </ul>
      <a class="btn" href="/pridat-provozovnu/">Přidat salon</a>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-mmenu]');
  if (btn && menu) {
    const nastav = (on: boolean) => {
      menu.hidden = !on;
      btn.setAttribute('aria-expanded', String(on));
    };
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      nastav(menu.hidden);
    });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !menu.contains(e.target as Node)) nastav(false);
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && nastav(false));
  }
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .hdr__in {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 80px;
  }
  .hdr__logo {
    text-decoration: none;
    color: var(--ink);
  }
  .hdr__logo :global(.logo) {
    --nuzky-logo: var(--accent);
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.25rem;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 500;
  }
  nav a {
    text-decoration: none;
    white-space: nowrap;
  }
  .nav-skryt-m a {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 0.9rem;
    border-radius: var(--pill);
    transition: background-color 150ms var(--ease-out);
  }
  @media (hover: hover) {
    .nav-skryt-m a:hover {
      background: var(--canvas);
      color: var(--ink);
    }
  }
  .hdr__cta {
    font-weight: 600;
  }
  .nav-jen-m {
    display: none;
  }
  .hdr__obl {
    position: relative;
    margin-left: 0.4rem;
  }
  .hdr__obl svg,
  .hdr__burger svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .hdr__obl-pocet {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 1.1rem;
    height: 1.1rem;
    padding: 0 0.28rem;
    border-radius: var(--pill);
    background: var(--accent);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
    line-height: 1.1rem;
    text-align: center;
    box-shadow: 0 0 0 2px #fff;
  }
  .hdr__burger[aria-expanded='true'] {
    background: var(--ink);
    color: #fff;
  }
  .mmenu {
    position: absolute;
    top: calc(100% - 8px);
    right: var(--gutter);
    width: min(280px, calc(100vw - 32px));
    padding: 0.5rem 0;
    background: #fff;
    border-radius: var(--radius);
    box-shadow: var(--sh-menu);
    transform-origin: top right;
    animation: mmenu-in 180ms var(--ease-out);
  }
  @keyframes mmenu-in {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.98);
    }
  }
  .mmenu[hidden] {
    display: none;
  }
  .mmenu ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0.5rem;
    border-bottom: 1px solid var(--line);
  }
  .mmenu li a {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--ink);
  }
  .mmenu li a:hover {
    background: var(--canvas);
  }
  .mmenu .btn {
    display: flex;
    margin: 0.75rem 1rem 0.25rem;
  }
  @media (max-width: 760px) {
    .hdr__in {
      min-height: 64px;
    }
    .nav-skryt-m {
      display: none;
    }
    .nav-jen-m {
      display: list-item;
    }
    nav ul {
      gap: 0.5rem;
    }
  }
  @media (max-width: 400px) {
    .hdr__logo :global(.logo) {
      font-size: 1.2rem;
    }
  }
</style>
