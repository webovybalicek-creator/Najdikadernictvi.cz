---
// Vybrané salony s fotkami: nejdřív kurátorský výběr redakce (UVOD_FOTKY), pak ostatní salony s fotkami.
// Záložky měst ukážou salony s fotkami z daného města. Pořadí je pevné, ať úvodní stránka působí upraveně.
import Karta from './Karta.astro';
import { PROVOZOVNY, UVOD_FOTKY, uplnost, type Provozovna } from '../lib/data';

const ZOBRAZIT = 8;
const podleId = new Map(PROVOZOVNY.map((p) => [p.id, p]));
const vybrane = UVOD_FOTKY.map((id) => podleId.get(id)).filter((p): p is Provozovna => !!p?.fotky?.length);
const ostatni = PROVOZOVNY.filter((p) => p.fotky?.length && !UVOD_FOTKY.includes(p.id)).sort(
  (a, b) => (b.fotky!.length - a.fotky!.length) || uplnost(b) - uplnost(a) || a.id.localeCompare(b.id),
);
const pool = [...vybrane, ...ostatni];
// Pražské obvody pod jednou záložkou „Praha“
const mestoKlic = (p: Provozovna) => (p.kraj === 'praha' ? 'praha' : p.mestoSlug);
const mestoNazev = (p: Provozovna) => (p.kraj === 'praha' ? 'Praha' : p.mesto);
const pocty = new Map<string, { nazev: string; n: number }>();
for (const p of pool) {
  const k = mestoKlic(p);
  pocty.set(k, { nazev: mestoNazev(p), n: (pocty.get(k)?.n ?? 0) + 1 });
}
const zalozky = [...pocty].filter(([, v]) => v.n >= 2).sort((a, b) => b[1].n - a[1].n || a[1].nazev.localeCompare(b[1].nazev, 'cs'));
---

{
  pool.length >= 4 && (
    <section class="vyb" data-vyb data-zobrazit={ZOBRAZIT}>
      <div class="wrap">
        <div class="vyb__hlava">
          <h2>Salony, kam se vyplatí zajít</h2>
          <p class="vyb__pod">Podívejte se dovnitř dřív, než se objednáte. Fotky, otevírací doba a kontakt na jednom místě.</p>
        </div>
        <div class="vyb__mesta" role="tablist" aria-label="Město">
          <button type="button" role="tab" aria-selected="true" data-vyb-mesto="">Doporučujeme</button>
          {zalozky.map(([k, v]) => <button type="button" role="tab" aria-selected="false" data-vyb-mesto={k}>{v.nazev}</button>)}
        </div>
        <ul class="vyb__pas" data-vyb-pas>
          {pool.map((p, i) => <Karta p={p} stav skryta={i >= ZOBRAZIT} mesto={mestoKlic(p)} />)}
        </ul>
        <p class="vyb__vice" data-vyb-vice hidden><a href="/" data-vyb-vice-odkaz>Všechna kadeřnictví</a></p>
      </div>
    </section>
  )
}

<script>
  import { aplikujStav } from '../scripts/stav';
  document.querySelectorAll<HTMLElement>('[data-vyb]').forEach((sek) => {
    const pas = sek.querySelector<HTMLElement>('[data-vyb-pas]')!;
    const karty = [...pas.querySelectorAll<HTMLElement>(':scope > li')];
    const n = Number(sek.dataset.zobrazit) || 8;
    const vice = sek.querySelector<HTMLElement>('[data-vyb-vice]')!;
    const ukaz = (mesto: string) => {
      const vybrane = new Set((mesto ? karty.filter((k) => k.dataset.mesto === mesto) : karty).slice(0, n));
      karty.forEach((k) => (k.hidden = !vybrane.has(k)));
      if (mesto) {
        vice.hidden = false;
        const a = vice.querySelector<HTMLAnchorElement>('[data-vyb-vice-odkaz]')!;
        a.href = `/${mesto}/`;
        a.textContent = `Všechna kadeřnictví: ${sek.querySelector(`[data-vyb-mesto="${mesto}"]`)!.textContent} →`;
      } else vice.hidden = true;
    };
    sek.querySelectorAll<HTMLButtonElement>('[data-vyb-mesto]').forEach((b) =>
      b.addEventListener('click', () => {
        sek.querySelectorAll('[data-vyb-mesto]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
        ukaz(b.dataset.vybMesto!);
      }),
    );
    aplikujStav(sek);
  });
</script>

<style>
  .vyb {
    position: relative;
    z-index: 1;
    padding: 48px 0 0;
  }
  .vyb__hlava h2 {
    margin: 0 0 0.35rem;
  }
  .vyb__pod {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.875rem;
  }
  /* Záložky měst jako na Airbnb: text, aktivní s 2px černou linkou */
  .vyb__mesta {
    display: flex;
    gap: 1.75rem;
    margin: 1.25rem 0 1.75rem;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-tap-highlight-color: transparent;
  }
  .vyb__mesta button {
    flex: none;
    position: relative;
    padding: 0.6rem 0 0.85rem;
    font: 500 0.875rem/1.2 var(--f-text);
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color 150ms var(--ease-out);
  }
  .vyb__mesta button::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--ink);
    transform: scaleX(0);
    transition: transform 200ms var(--ease-out);
  }
  @media (hover: hover) {
    .vyb__mesta button:hover {
      color: var(--ink);
    }
    .vyb__mesta button:hover::after {
      transform: scaleX(1);
      background: var(--line-strong);
    }
  }
  .vyb__mesta button[aria-selected='true'] {
    color: var(--ink);
    font-weight: 600;
  }
  .vyb__mesta button[aria-selected='true']::after {
    transform: scaleX(1);
    background: var(--ink);
  }
  .vyb__pas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem 1.5rem;
  }
  .vyb__pas :global(.viz) {
    border-radius: var(--radius);
  }
  .vyb__vice {
    margin: 1.5rem 0 0;
    font-weight: 500;
  }
  @media (max-width: 960px) {
    .vyb__pas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 400px) {
    .vyb__pas {
      gap: 1.5rem 0.75rem;
    }
  }
</style>
