---
// Hodnocení salonu na Googlu – vždy jasně označené jako Google, odděleně od hodnocení na našem webu
import type { Provozovna } from '../lib/data';
interface Props {
  p: Provozovna;
  maly?: boolean;
}
const { p, maly = false } = Astro.props;
const g = p.google;
const href = g?.url ?? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${p.nazev} ${p.ulice ?? ''} ${p.mesto}`.replace(/\s+/g, ' ').trim())}`;
const datum = g ? new Date(g.datum).toLocaleDateString('cs-CZ', { day: 'numeric', month: 'numeric', year: 'numeric' }) : '';
const recenzi = (n: number) => (n === 1 ? 'recenze' : n >= 2 && n <= 4 ? 'recenze' : 'recenzí');
---

{
  g && (
    <a
      class:list={['ghod', maly && 'ghod--maly']}
      href={href}
      rel="noopener nofollow"
      target="_blank"
      title={`Hodnocení na Googlu, stav k ${datum}. Otevře kartu salonu v Google Mapách.`}
    >
      <span class="ghod__g" aria-hidden="true">G</span>
      <span class="ghod__z">Google</span>
      <strong>{g.h.toLocaleString('cs-CZ', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}</strong>
      <span class="ghod__h" aria-hidden="true">★</span>
      <span class="ghod__n">({g.n.toLocaleString('cs-CZ')}{maly ? '' : ` ${recenzi(g.n)}`})</span>
      {!maly && <span class="ghod__d">k {datum}</span>}
    </a>
  )
}

<style>
  .ghod {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.88rem;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.25em 0.75em 0.25em 0.3em;
    background: #fff;
    white-space: nowrap;
  }
  .ghod:hover {
    border-color: var(--ink);
  }
  .ghod__g {
    display: inline-grid;
    place-items: center;
    width: 1.35em;
    height: 1.35em;
    border-radius: 50%;
    background: conic-gradient(#ea4335 0 25%, #fbbc05 0 50%, #34a853 0 75%, #4285f4 0);
    color: #fff;
    font-weight: 700;
    font-size: 0.8em;
  }
  .ghod__z {
    color: var(--ink-soft);
  }
  .ghod__h {
    color: #f5a623;
  }
  .ghod__n,
  .ghod__d {
    color: var(--ink-soft);
  }
  .ghod__d {
    font-size: 0.8em;
  }
  .ghod--maly {
    font-size: 0.8rem;
    padding: 0.15em 0.6em 0.15em 0.25em;
  }
</style>
