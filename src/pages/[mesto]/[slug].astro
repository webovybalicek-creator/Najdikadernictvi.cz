---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProvozovnaRadek from '../../components/ProvozovnaRadek.astro';
import Vizual from '../../components/Vizual.astro';
import Tipy from '../../components/Tipy.astro';
import Hodnoceni from '../../components/Hodnoceni.astro';
import GoogleHodnoceni from '../../components/GoogleHodnoceni.astro';
import AkceSalonu from '../../components/AkceSalonu.astro';
import Overeno from '../../components/Overeno.astro';
import NahlasitChybu from '../../components/NahlasitChybu.astro';
import {
  PROVOZOVNY,
  adresa,
  tyden,
  vOkoli,
  mestoUrl,
  krajUrl,
  url,
  TYP_NAZEV,
  ZAMERENI_NAZEV,
  mesta,
  pocetText,
  indexovatDetail,
  ctvrtSalonu,
  ctvrtUrl,
  type Provozovna,
} from '../../lib/data';
import { zameryMesta, zamerUrl } from '../../lib/seo-mesto';
import { KRAJE } from '../../lib/kraje';
import { DNY, denText, souhrn, schemaSpec } from '../../lib/oteviraci-doba';
import { SITE } from '../../lib/config';
import { metaSalonu } from '../../lib/meta';
import { srovnani } from '../../lib/srovnani';
import PotvrzeniDoby from '../../components/PotvrzeniDoby.astro';
import CenyNavstevniku from '../../components/CenyNavstevniku.astro';
import svatkyRaw from '../../data/svatky.json';

export function getStaticPaths() {
  return PROVOZOVNY.map((p) => ({ params: { mesto: p.mestoSlug, slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Provozovna };
const kraj = KRAJE.find((k) => k.slug === p.kraj)!;
const t = tyden(p);
const adr = adresa(p);
const okoli = vOkoli(p, 6);
const vMeste = mesta().find((m) => m.slug === p.mestoSlug)!.provozovny.length;
const typ = TYP_NAZEV[p.typ];
const zam = p.zamereni.map((z) => ZAMERENI_NAZEV[z].toLowerCase());

const navigace = {
  mapy: `https://mapy.com/fnc/v1/route?end=${p.lon},${p.lat}`,
  google: `https://www.google.com/maps/dir/?api=1&destination=${p.lat},${p.lon}`,
};

// Popis z dostupných údajů
const vety: string[] = [];
vety.push(
  `${p.nazev} je ${p.typ === 'barber' ? 'barbershop' : 'kadeřnictví'}${zam.length ? ` se zaměřením na ${zam.map((z) => (z === 'unisex' ? 'muže i ženy' : z === 'pánské' ? 'pány' : z === 'dámské' ? 'dámy' : 'děti')).join(' a ')}` : ''}${adr ? ` na adrese ${adr}` : ` v obci ${p.mesto}`}.`,
);
if (t) {
  const s = souhrn(t).filter((x) => x.cas !== 'Zavřeno');
  if (s.length) vety.push(`Otevřeno má ${s.map((x) => `${x.dny} ${x.cas}`).join(', ')}.`);
}
const kontakt = [p.telefon && 'telefonicky', p.web && 'přes web', (p.facebook || p.instagram) && 'přes sociální sítě'].filter(Boolean);
if (kontakt.length) vety.push(`Objednat se můžete ${kontakt.join(', ').replace(/, ([^,]*)$/, ' nebo $1')}.`);
if (vMeste > 1) vety.push(`V obci ${p.mesto} evidujeme celkem ${pocetText(vMeste, 'salon', 'salony', 'salonů')}.`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': p.typ === 'barber' ? 'BarberShop' : 'HairSalon',
  name: p.nazev,
  url: new URL(url(p), SITE.url).href,
  address: {
    '@type': 'PostalAddress',
    streetAddress: [p.ulice, p.cisloDomu].filter(Boolean).join(' ') || undefined,
    postalCode: p.psc,
    addressLocality: p.mesto,
    addressRegion: kraj.nazev,
    addressCountry: 'CZ',
  },
  geo: { '@type': 'GeoCoordinates', latitude: p.lat, longitude: p.lon },
  telephone: p.telefon,
  email: p.email,
  sameAs: [p.web, p.facebook, p.instagram].filter(Boolean),
  openingHoursSpecification: t ? schemaSpec(t) : undefined,
  description: p.popis,
  image: p.fotky?.map((f) => new URL(f, SITE.url).href),
  hasOfferCatalog: p.cenik?.length
    ? {
        '@type': 'OfferCatalog',
        name: 'Ceník',
        itemListElement: p.cenik.map((c) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: c.polozka }, description: c.cena })),
      }
    : undefined,
};

const breadcrumb = [
  ...(kraj.nazev !== p.mesto ? [{ nazev: kraj.nazev, href: krajUrl(kraj.slug) }] : []),
  { nazev: p.mesto, href: mestoUrl(p.mestoSlug) },
  { nazev: p.nazev },
];
// Vnitřní odkazy: čtvrť a výběry ve městě, do kterých salon patří
const mestoObj = mesta().find((x) => x.slug === p.mestoSlug)!; // (mesta() je cachované)
const ctvrt = ctvrtSalonu(p);
const vybery = zameryMesta(mestoObj).filter(({ ids }) => ids.has(p.id));
const meta = metaSalonu(p, okoli.length);
// Srovnání s okolím jen u salonů s obsahem (ostatní jsou noindex, ušetří čas buildu)
const sr = indexovatDetail(p) ? srovnani(p) : null;
const svatky = Object.entries((svatkyRaw as { salony: Record<string, { dny: Record<string, string> }> }).salony[p.id]?.dny ?? {}).sort();
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base
  title={meta.title}
  description={meta.description}
  jsonLd={jsonLd}
  noindex={!indexovatDetail(p)}
>
  <div class="wrap section">
    <Breadcrumb items={breadcrumb} />

    <header class="head">
      <figure class="head__viz">
        <Vizual p={p} velky panorama />
      </figure>
      <div class="head__txt">
      <p class="head__typ">
        <span class:list={['tag', p.typ === 'barber' && 'tag--barber']}>{typ}</span>
        {p.zamereni.filter((z) => z !== 'unisex').map((z) => <span class="tag">{ZAMERENI_NAZEV[z]}</span>)}
      </p>
      <h1>{p.nazev}</h1>
      {p.overeno && <p class="head__over"><Overeno datum={p.overeno} /></p>}
      {t && <p class="head__stav" data-oh={JSON.stringify(t)}><span class="stav"></span></p>}
      <p class="head__adr">{adr || p.mesto}</p>
      <a class="hod-mini head__hod" href="#hodnoceni" data-hod-id={p.id}><span class="hv" style="--p:0%"></span><span class="hod-mini__nic">Ohodnotit salon</span></a>
      {p.google && <p class="head__g"><GoogleHodnoceni p={p} /></p>}
      <div class="akce">
        {p.rezervace && <a class="btn" href={p.rezervace} rel="noopener nofollow" target="_blank">Rezervovat online</a>}
        {p.telefon && <a class:list={['btn', p.rezervace && 'btn--ghost']} href={`tel:${p.telefon.replace(/\s/g, '')}`}>Zavolat {p.telefon}</a>}
        <a class:list={['btn', (p.telefon || p.rezervace) && 'btn--ghost']} href={navigace.google} rel="noopener" target="_blank">Navigovat</a>
      </div>
      <AkceSalonu p={p} />
      </div>
    </header>

    <div class="grid">
      <div class="info">
        <section>
          <h2>Otevírací doba</h2>
          {
            t ? (
              <table class="doba" data-tyden>
                <tbody>
                  {DNY.map((d, i) => (
                    <tr data-den={i}>
                      <th scope="row">{d}</th>
                      <td>{denText(t[i])}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            ) : p.oteviraciDoba ? (
              <p>{p.oteviraciDoba}</p>
            ) : (
              <p class="muted">
                Otevírací dobu zatím neznáme. {p.telefon ? 'Ověřte si ji prosím telefonicky.' : ''}
              </p>
            )
          }
          {
            svatky.length > 0 && (
              <div class="svatky">
                <p class="svatky__h">O svátcích (potvrzeno salonem)</p>
                <ul>
                  {svatky.map(([d, h]) => (
                    <li>
                      <span>{new Date(d).toLocaleDateString('cs-CZ', { weekday: 'short', day: 'numeric', month: 'numeric' })}</span>
                      <span>{h}</span>
                    </li>
                  ))}
                </ul>
                <a href="/kadernictvi-o-svatcich/">Kdo další má otevřeno o svátcích →</a>
              </div>
            )
          }
          {(t || p.oteviraciDoba) && <PotvrzeniDoby id={p.id} url={url(p)} />}
        </section>

        <section>
          <h2>Kontakt</h2>
          <dl class="udaje">
            <dt>Adresa</dt>
            <dd>{adr || p.mesto}{p.cast && p.cast !== p.mesto && !adr.includes(p.cast) && <>, {p.cast}</>}</dd>
            {p.telefon && (<><dt>Telefon</dt><dd><a href={`tel:${p.telefon.replace(/\s/g, '')}`}>{p.telefon}</a></dd></>)}
            {p.email && (<><dt>E-mail</dt><dd><a href={`mailto:${p.email}`}>{p.email}</a></dd></>)}
            {p.web && (<><dt>Web</dt><dd><a href={p.web} rel="noopener nofollow" target="_blank">{host(p.web)}</a></dd></>)}
            {p.instagram && (<><dt>Instagram</dt><dd><a href={p.instagram} rel="noopener nofollow" target="_blank">{host(p.instagram).replace(/^instagram\.com\//, '@')}</a></dd></>)}
            {p.facebook && (<><dt>Facebook</dt><dd><a href={p.facebook} rel="noopener nofollow" target="_blank">Profil na Facebooku</a></dd></>)}
            {p.platbaKartou && (<><dt>Platba kartou</dt><dd>{p.platbaKartou === 'yes' ? 'Ano' : 'Ne, jen hotově'}</dd></>)}
            {p.bezbarierove && (<><dt>Bezbariérový přístup</dt><dd>{p.bezbarierove === 'yes' ? 'Ano' : p.bezbarierove === 'limited' ? 'Částečně' : 'Ne'}</dd></>)}
          </dl>
        </section>

        {
          p.cenik?.length ? (
            <section>
              <h2>Ceník</h2>
              <table class="cenik">
                <tbody>
                  {p.cenik.map((c) => (
                    <tr>
                      <th scope="row">{c.polozka}</th>
                      <td>{c.cena}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              <p class="muted cenik__pozn">Ceny uvádí salon. Konečná cena se může lišit podle délky vlasů a náročnosti.</p>
            </section>
          ) : (
            indexovatDetail(p) && <CenyNavstevniku id={p.id} mesto={p.mestoSlug} barber={p.typ === 'barber'} />
          )
        }

        {
          p.fotky && p.fotky.length > 1 && (
            <section>
              <h2>Fotky</h2>
              <ul class="galerie">
                {p.fotky.map((f, i) => (
                  <li>
                    <a href={f} target="_blank" rel="noopener">
                      <img src={f} alt={`${p.nazev} – fotka ${i + 1}`} loading="lazy" decoding="async" />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section>
          <h2>O salonu</h2>
          {p.popis && <p class="popis-majitel">{p.popis}</p>}
          {vety.map((v) => <p>{v}</p>)}
        </section>

        {
          sr && (sr.fakta.length > 0 || sr.alternativy.length > 0) && (
            <section class="srov">
              <h2>Srovnání s okolím</h2>
              {sr.fakta.length > 0 && <ul class="srov__fakta">{sr.fakta.map((f) => <li>{f}</li>)}</ul>}
              {
                sr.alternativy.length > 0 && (
                  <>
                    <h3 class="srov__h">Když tady nepochodíte</h3>
                    <ul class="srov__alt">
                      {sr.alternativy.map((a) => (
                        <li>
                          <span class="srov__popis">{a.popis}</span>
                          <a href={a.href}>{a.nazev}</a>
                          <span class="srov__km">{a.vzdalenost}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )
              }
              <p class="muted srov__pozn">Spočítáno z otevíracích dob salonů v našem katalogu. Údaje se můžou lišit, před návštěvou je ověřte.</p>
            </section>
          )
        }
      </div>

      <div class="mapa-wrap">
        <div
          id="mapa"
          class="mapa"
          data-lat={p.lat}
          data-lon={p.lon}
          data-nazev={p.nazev}
          role="img"
          aria-label={`Mapa: ${p.nazev}, ${adr || p.mesto}`}
        >
        </div>
        <p class="mapa__odkazy">
          Otevřít v <a href={`https://mapy.com/zakladni?x=${p.lon}&y=${p.lat}&z=17&source=coor&id=${p.lon},${p.lat}`} rel="noopener" target="_blank">Mapy.com</a> nebo <a href={`https://www.google.com/maps/search/?api=1&query=${p.lat},${p.lon}`} rel="noopener" target="_blank">Google Maps</a>
        </p>

        <div class="majitel">
          <h2>{p.overeno ? 'Změna údajů?' : 'Je to váš salon?'}</h2>
          <p>{p.overeno ? 'Údaje ověřil majitel. Pokud se něco změnilo, dejte nám vědět.' : 'Ověřte profil a doplňte ceník, popis, rezervace a aktuální otevírací dobu. Je to zdarma.'}</p>
          <a class="btn" href={`/sprava/?salon=${p.id}&u=${encodeURIComponent(url(p))}`}>Spravovat profil</a>
          <p class="majitel__alt"><a href={`/pridat-provozovnu/?salon=${encodeURIComponent(url(p))}&nazev=${encodeURIComponent(p.nazev)}&id=${p.id}`}>Nebo nám pošlete změny formulářem</a></p>
          <p class="majitel__alt"><a href={`/plakat/?u=${encodeURIComponent(url(p))}`} rel="nofollow">Plakát do výlohy s QR kódem</a></p>
        </div>
      </div>
    </div>

    <Hodnoceni p={p} />

    {
      okoli.length > 0 && (
        <section class="okoli">
          <h2>Další salony v okolí</h2>
          <ul>
            {okoli.map(({ p: o, km }) => (
              <ProvozovnaRadek p={o} vzdalenost={km} sMestem={o.mesto !== p.mesto} />
            ))}
          </ul>
          <ul class="souvis">
            <li><a href={mestoUrl(p.mestoSlug)}>Všechna kadeřnictví: {p.mesto}</a></li>
            {ctvrt && <li><a href={ctvrtUrl(ctvrt)}>Kadeřnictví {p.mesto} – {ctvrt.nazev}</a></li>}
            {vybery.map(({ z }) => <li><a href={zamerUrl(z, p.mestoSlug)}>{z.nazev(p.mesto)}</a></li>)}
          </ul>
        </section>
      )
    }

    <p class="zdroj muted">
      {
        p.overeno ? (
          <>Údaje ověřil majitel salonu {new Date(p.overeno).toLocaleDateString('cs-CZ')}.</>
        ) : p.zdroj === 'osm' ? (
          <>Údaje pochází z <a href={p.osm} rel="noopener" target="_blank">OpenStreetMap</a> a nemusí být aktuální.</>
        ) : (
          <>Adresa pochází z veřejného živnostenského rejstříku (provozovna s živností Holičství, kadeřnictví). Salon nemusí být v provozu.</>
        )
      }
    </p>
    <NahlasitChybu p={p} />
    <script
      type="application/json"
      id="salon-data"
      set:html={JSON.stringify({
        id: p.id,
        nazev: p.nazev,
        adresa: adr || p.mesto,
        telefon: p.telefon ?? '',
        email: p.email ?? '',
        web: p.web ?? '',
        instagram: p.instagram ?? '',
        facebook: p.facebook ?? '',
        rezervace: p.rezervace ?? '',
        popis: p.popis ?? '',
        cenik: p.cenik ?? [],
        tyden: t,
        platbaKartou: p.platbaKartou ?? '',
        bezbarierove: p.bezbarierove ?? '',
        zamereni: p.zamereni,
      }).replace(/</g, '\\u003c')}
    />
  </div>
  <Tipy />
</Base>

<script>
  import { zapisHistorii } from '../../scripts/oblibene';
  const srd = document.querySelector<HTMLElement>('.akce2 [data-oblibene]');
  if (srd) zapisHistorii(JSON.parse(srd.dataset.oblibene!));
</script>

<script>
  import 'leaflet/dist/leaflet.css';
  import { aplikujStav, prahaTed } from '../../scripts/stav';
  aplikujStav();
  const { den } = prahaTed();
  document.querySelector(`[data-tyden] tr[data-den="${den}"]`)?.classList.add('dnes');

  const el = document.getElementById('mapa');
  if (el) {
    const nacti = async () => {
      const L = (await import('leaflet')).default;
      const lat = Number(el.dataset.lat);
      const lon = Number(el.dataset.lon);
      const map = L.map(el, { scrollWheelZoom: false }).setView([lat, lon], 16);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);
      L.circleMarker([lat, lon], {
        radius: 10,
        color: '#ffffff',
        weight: 3,
        fillColor: '#ff385c',
        fillOpacity: 1,
      })
        .addTo(map)
        .bindTooltip(el.dataset.nazev ?? '', { direction: 'top', offset: [0, -10] });
    };
    const io = new IntersectionObserver((e) => {
      if (e[0].isIntersecting) {
        io.disconnect();
        nacti();
      }
    });
    io.observe(el);
  }
</script>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .head__viz {
    order: 2;
    margin: 0;
  }
  .head__popis {
    display: none;
    margin-top: 0.25rem;
  }
  .head__viz:has(:global(.viz__foto.ok)) .head__popis {
    display: block;
  }
  @media (max-width: 860px) {
    .head {
      grid-template-columns: 1fr;
    }
    .head__viz {
      order: 0;
      max-width: 28rem;
    }
  }
  .head__typ {
    display: flex;
    gap: 0.4rem;
    margin: 0 0 0.75rem;
  }
  .head h1 {
    margin-bottom: 0.25em;
  }
  .head__adr {
    font-size: 1.05rem;
    color: var(--ink-soft);
    margin: 0 0 0.35rem;
  }
  .head__hod {
    font-size: 0.9rem;
    text-decoration: none;
    margin-bottom: 0.25rem;
  }
  .head__stav {
    margin: 0 0 0.35rem;
  }
  .head__stav .stav {
    font-size: 1rem;
    font-weight: 500;
  }
  .akce {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .info section {
    margin-bottom: 2rem;
  }
  .info h2,
  .majitel h2,
  .okoli h2 {
    font-size: 1.75rem;
  }
  .doba {
    border-collapse: collapse;
    width: 100%;
    max-width: 26rem;
  }
  .doba th,
  .doba td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    font-weight: 400;
  }
  .doba th {
    width: 40%;
  }
  .doba :global(tr.dnes) {
    background: var(--mint);
    font-weight: 700;
  }
  .doba :global(tr.dnes) th {
    font-weight: 700;
  }
  .udaje {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.5rem 1.5rem;
    margin: 0;
  }
  .udaje dt {
    color: var(--ink-soft);
  }
  .udaje dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .mapa {
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--mint);
    z-index: 0;
  }
  .mapa__odkazy {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 0.5rem 0 1.5rem;
  }
  .majitel {
    background: var(--mint);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .majitel p {
    margin-bottom: 1rem;
  }
  .okoli {
    margin-top: clamp(32px, 5vw, 56px);
  }
  .okoli ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .souvis {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .galerie {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr));
    gap: 0.5rem;
  }
  .galerie img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .majitel__alt {
    margin: 0.75rem 0 0;
    font-size: 0.85rem;
  }
  .head__over {
    margin: -0.25rem 0 0.5rem;
  }
  .cenik {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .cenik th,
  .cenik td {
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
    text-align: left;
