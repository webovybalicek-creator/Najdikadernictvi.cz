---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ProvozovnaRadek from '../../components/ProvozovnaRadek.astro';
import MapaSalonu from '../../components/MapaSalonu.astro';
import Faq from '../../components/Faq.astro';
import OdberNovinek from '../../components/OdberNovinek.astro';
import { statistiky, textMesta, faqMesta, faqJsonLd, itemListJsonLd, zameryMesta, zamerUrl } from '../../lib/seo-mesto';
import { mesta, mestaSloucena, mestoUrl, krajUrl, pocetText, tyden, ctvrti, ctvrtUrl, type Mesto } from '../../lib/data';

export function getStaticPaths() {
  // /praha/ má vlastní rozcestník (src/pages/praha/index.astro)
  return mesta()
    .filter((m) => m.slug !== 'praha')
    .map((m) => ({ params: { mesto: m.slug }, props: { m } }));
}

const { m } = Astro.props as { m: Mesto };
const vse = m.provozovny;
const barberu = vse.filter((p) => p.typ === 'barber').length;
const sDobou = vse.filter((p) => tyden(p)).length;
const casti = [...new Set(vse.map((p) => p.cast).filter(Boolean) as string[])].sort((a, b) => a.localeCompare(b, 'cs'));
const vlastnosti = (p: (typeof vse)[number]) => [
  ...p.zamereni,
  ...(p.bezbarierove === 'yes' || p.bezbarierove === 'limited' ? ['bezbarierove'] : []),
  ...(p.platbaKartou === 'yes' ? ['karta'] : []),
];
const zamereni = ['panske', 'damske', 'detske', 'bezbarierove', 'karta'].filter((z) => vse.filter((p) => vlastnosti(p).includes(z)).length >= 2);
const ZN: Record<string, string> = { panske: 'Pánské', damske: 'Dámské', detske: 'Dětské', bezbarierove: 'Bezbariérové', karta: 'Platba kartou' };

// Okolní obce: nejbližší střed obce
const stred = (x: Mesto) => ({
  lat: x.provozovny.reduce((s, p) => s + p.lat, 0) / x.provozovny.length,
  lon: x.provozovny.reduce((s, p) => s + p.lon, 0) / x.provozovny.length,
});
const c = stred(m);
const okoli = (m.kraj.slug === 'praha' ? mesta() : mestaSloucena())
  .filter((o) => o.slug !== m.slug)
  .map((o) => {
    const s = stred(o);
    return { o, d: (s.lat - c.lat) ** 2 + ((s.lon - c.lon) * 0.64) ** 2 };
  })
  .sort((a, b) => a.d - b.d)
  .slice(0, 10)
  .map((x) => x.o);

const breadcrumb = [
  ...(m.kraj.nazev !== m.nazev ? [{ nazev: m.kraj.nazev, href: krajUrl(m.kraj.slug) }] : []),
  { nazev: m.nazev },
];
const st = statistiky(vse);
const uvod = textMesta(m, st);
const faq = faqMesta(m, st);
const zamery = zameryMesta(m);
const castiMesta = ctvrti(m);
/** Kolik salonů ukázat hned, zbytek po kliknutí (celý seznam je v HTML kvůli vyhledávačům) */
const ZOBRAZIT = 60;
const jsonLd = [itemListJsonLd(`Kadeřnictví ${m.nazev}`, vse), ...(faq.length > 1 ? [faqJsonLd(faq)] : [])];
---

<Base
  title={`Kadeřnictví ${m.nazev}: ${pocetText(vse.length, 'salon', 'salony', 'salonů')}`}
  description={`Kadeřnictví a barbershopy ${m.nazev} (${m.kraj.nazev}): ${pocetText(vse.length, 'salon', 'salony', 'salonů')} s adresou, telefonem a otevírací dobou. Zjistěte, kdo má právě otevřeno.`}
  jsonLd={jsonLd}
>
  <div class="wrap section">
    <Breadcrumb items={breadcrumb} />
    <h1>Kadeřnictví {m.nazev}</h1>
    <div class="uvod">
      <p class="lead">{uvod[0]}</p>
    </div>
    {
      zamery.length > 0 && (
        <nav class="zamery" aria-label="Upřesnit výběr">
          {zamery.map(({ z, salony }) => (
            <a href={zamerUrl(z, m.slug)}>
              {z.nazev(m.nazev).replace(`: ${m.nazev}`, '').replace(` ${m.nazev}`, '')} <span>{salony.length}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      castiMesta.length > 0 && (
        <details class="casti-det" open={castiMesta.length <= 8}>
          <summary>Podle čtvrti <span>{castiMesta.length}</span></summary>
          <nav class="zamery zamery--casti" aria-label="Podle části obce">
            {castiMesta.map((c) => (
              <a href={ctvrtUrl(c)}>
                {c.nazev} <span>{c.provozovny.length}</span>
              </a>
            ))}
          </nav>
        </details>
      )
    }

    {
      vse.length > 3 && (
        <form class="filtry" data-filtry aria-label="Filtrovat salony">
          <label class="filtry__q">
            <span class="sr-only">Hledat podle názvu nebo ulice</span>
            <input type="search" name="q" placeholder="Název nebo ulice" />
          </label>
          {casti.length > 1 && (
            <label>
              <span class="sr-only">Část obce</span>
              <select name="cast">
                <option value="">Všechny části</option>
                {casti.map((c) => <option value={c.toLowerCase()}>{c}</option>)}
              </select>
            </label>
          )}
          <fieldset class="seg">
            <legend class="sr-only">Typ</legend>
            <label><input type="radio" name="typ" value="" checked /><span>Vše</span></label>
            <label><input type="radio" name="typ" value="kadernictvi" /><span>Kadeřnictví</span></label>
            {barberu > 0 && <label><input type="radio" name="typ" value="barber" /><span>Barbershop</span></label>}
          </fieldset>
          {zamereni.map((z) => (
            <label class="chk"><input type="checkbox" name="zamereni" value={z} /> {ZN[z]}</label>
          ))}
          {sDobou > 0 && <label class="chk"><input type="checkbox" name="open" value="1" /> Otevřeno teď</label>}
          <label class="razeni">
            <span>Řadit:</span>
            <select name="razeni">
              <option value="">Doporučené</option>
              <option value="hodnoceni">Nejlépe hodnocené</option>
              <option value="otevreno">Otevřeno teď</option>
              <option value="abeceda">Abecedně</option>
              <option value="blizko">Nejblíž mně</option>
            </select>
          </label>
          <p class="filtry__pocet" aria-live="polite" data-pocet></p>
        </form>
      )
    }

    <ul class:list={['seznam', vse.length > ZOBRAZIT && 'zkraceny']} data-seznam style={`--zobrazit:${ZOBRAZIT}`}>
      {vse.map((p, i) => <ProvozovnaRadek p={p} nahled={i < 30} />)}
    </ul>
    {
      vse.length > ZOBRAZIT && (
        <p class="dalsi-btn" data-dalsi-wrap>
          <button type="button" class="btn btn--ghost" data-dalsi>
            Zobrazit všech {pocetText(vse.length, 'salon', 'salony', 'salonů')}
          </button>
        </p>
      )
    }
    <p class="prazdno" data-prazdno hidden>Žádný salon neodpovídá filtrům. Zkuste některý filtr vypnout.</p>

    {
      vse.length > 1 && (
        <section class="blok">
          <h2>Mapa salonů</h2>
          <MapaSalonu salony={vse} popis={`Mapa kadeřnictví: ${m.nazev}`} />
        </section>
      )
    }

    {
      uvod.length > 1 && (
        <section class="blok o-meste">
          <h2>Kadeřnictví {m.nazev} v číslech</h2>
          {uvod.slice(1).map((t) => <p>{t}</p>)}
        </section>
      )
    }

    {faq.length > 1 && <Faq polozky={faq} nadpis={`Časté dotazy: kadeřnictví ${m.nazev}`} />}

    <aside class="dalsi">
      <div>
        <h2>Okolní obce</h2>
        <ul class="okoli">
          {okoli.map((o) => <li><a href={mestoUrl(o.slug)}>{o.nazev}</a> <span class="muted">{o.provozovny.length}</span></li>)}
        </ul>
      </div>
      <div class="chybi">
        <h2>Chybí tu salon?</h2>
        <p>Pokud znáte kadeřnictví {m.nazev}, které tu chybí, nebo je některý údaj špatně, dejte nám vědět.</p>
        <a class="btn btn--ghost" href="/pridat-provozovnu/">Přidat salon</a>
      </div>
      <OdberNovinek mesto={m.slug} nazev={m.nazev} />
    </aside>
  </div>
</Base>

<script>
  import { aplikujStav } from '../../scripts/stav';
  aplikujStav();

  const norm = (s: string) =>
    s
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .toLowerCase();
  const form = document.querySelector<HTMLFormElement>('[data-filtry]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-seznam] > li')];
  const pocet = document.querySelector<HTMLElement>('[data-pocet]');
  const prazdno = document.querySelector<HTMLElement>('[data-prazdno]');

  function filtruj() {
    if (!form) return;
    const fd = new FormData(form);
    const q = norm(String(fd.get('q') ?? '')).trim();
    const cast = String(fd.get('cast') ?? '');
    const typ = String(fd.get('typ') ?? '');
    const zam = fd.getAll('zamereni').map(String);
    const open = fd.get('open') === '1';
    let n = 0;
    for (const r of rows) {
      const ok =
        (!q || norm(r.dataset.hledat ?? '').includes(q)) &&
        (!cast || (r.dataset.hledat ?? '').includes(cast)) &&
        (!typ || r.dataset.typ === typ) &&
        zam.every((z) => (r.dataset.zamereni ?? '').split(' ').includes(z)) &&
        (!open || r.dataset.open === '1');
      r.hidden = !ok;
      if (ok) n++;
    }
    if (pocet) pocet.textContent = n === rows.length ? '' : `Zobrazeno ${n} z ${rows.length}`;
    if (n !== rows.length) rozbal();
    if (prazdno) prazdno.hidden = n > 0;
  }
  // Zkrácený výpis velkých měst
  function rozbal() {
    document.querySelector('[data-seznam]')?.classList.remove('zkraceny');
    const w = document.querySelector<HTMLElement>('[data-dalsi-wrap]');
    if (w) w.hidden = true;
  }
  document.querySelector('[data-dalsi]')?.addEventListener('click', rozbal);

  // Řazení výpisu
  const seznamEl = document.querySelector<HTMLElement>('[data-seznam]');
  rows.forEach((r, i) => (r.dataset.poradi = String(i)));
  let souhrnHod: Record<string, [number, number]> | null = null;
  let poloha: { lat: number; lon: number } | null = null;
  const km = (a: { lat: number; lon: number }, r: HTMLElement) => {
    const dy = (Number(r.dataset.lat) - a.lat) * 111.3;
    const dx = (Number(r.dataset.lon) - a.lon) * 111.3 * Math.cos((a.lat * Math.PI) / 180);
    return Math.hypot(dx, dy);
  };
  async function serad(zpusob: string) {
    let klic: (r: HTMLElement) => number | string;
    if (zpusob === 'hodnoceni') {
      souhrnHod ??= await fetch('/api/hodnoceni.php?souhrn=1').then((r) => (r.ok ? r.json() : {})).catch(() => ({}));
      klic = (r) => {
        const h = souhrnHod![r.dataset.id!];
        return h ? -(h[0] * 1000 + h[1]) : 0;
      };
    } else if (zpusob === 'otevreno') {
      klic = (r) => (r.dataset.open === '1' ? 0 : r.dataset.oh ? 1 : 2);
    } else if (zpusob === 'abeceda') {
      klic = (r) => r.dataset.nazev ?? '';
    } else if (zpusob === 'blizko') {
      if (!poloha) {
        try {
          const pos = await new Promise<GeolocationPosition>((ok, ko) =>
            navigator.geolocation.getCurrentPosition(ok, ko, { timeout: 15000, maximumAge: 300000 }),
          );
          poloha = { lat: pos.coords.latitude, lon: pos.coords.longitude };
        } catch {
          if (pocet) pocet.textContent = 'Polohu se nepodařilo zjistit.';
          return;
        }
      }
      klic = (r) => km(poloha!, r);
    } else {
      klic = (r) => Number(r.dataset.poradi);
    }
    const serazene = [...rows].sort((a, b) => {
      const x = klic(a);
      const y = klic(b);
      const c = typeof x === 'string' ? x.localeCompare(String(y), 'cs') : x - (y as number);
      return c || Number(a.dataset.poradi) - Number(b.dataset.poradi);
    });
    seznamEl?.append(...serazene);
  }
  form?.querySelector('select[name=razeni]')?.addEventListener('change', (e) => {
    e.stopPropagation();
    serad((e.target as HTMLSelectElement).value);
  });

  form?.addEventListener('input', filtruj);
  form?.addEventListener('submit', (e) => e.preventDefault());
</script>

<style>
  .uvod p {
    margin-bottom: 0.6rem;
  }
  .uvod p:not(.lead) {
    color: var(--ink-soft);
  }
  .o-meste p {
    color: var(--ink-soft);
  }
  .zamery {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }
  .zamery a {
    display: inline-flex;
    gap: 0.5em;
    align-items: center;
    padding: 0.4em 0.95em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .zamery a:hover {
    border-color: var(--ink);
  }
  .zamery span {
    color: var(--ink-soft);
  }
  .zamery--casti {
    align-items: center;
    margin-top: 0.75rem;
  }
  .casti-det {
    margin-top: 1rem;
  }
  .casti-det summary {
    cursor: pointer;
    width: fit-content;
    font-size: 0.9rem;
    font-weight: 500;
  }
  .casti-det summary span {
    color: var(--ink-soft);
    font-weight: 400;
    margin-left: 0.25rem;
  }
  .blok {
    margin-top: clamp(40px, 6vw, 64px);
  }
  .filtry {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin: 1.75rem 0 0.5rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .filtry input[type='search'],
  .filtry select {
    font: inherit;
    font-size: 0.95rem;
    padding: 0.5rem 0.7rem;
    border: 1.5px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
  }
  .filtry__q {
    flex: 1 1 14rem;
  }
  .filtry__q input {
    width: 100%;
  }
  .seg {
    display: inline-flex;
    border: 1.5px solid var(--bottle);
    border-radius: var(--radius);
    padding: 0;
    margin: 0;
    overflow: hidden;
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    opacity: 0;
  }
  .seg span {
    display: block;
    padding: 0.4rem 0.8rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .seg input:checked + span {
    background: var(--bottle);
    color: var(--bottle-ink);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }
  .chk {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.95rem;
    cursor: pointer;
  }
  .chk input {
    accent-color: var(--bottle);
    width: 1.05rem;
    height: 1.05rem;
  }
  .razeni {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    margin-left: auto;
  }
  .razeni span {
    color: var(--ink-soft);
  }
  .filtry__pocet {
    margin: 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .filtry__pocet:empty {
    display: none;
  }
  .seznam {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  /* Řádky mimo obrazovku prohlížeč nevykresluje, dokud k nim nedoroluje */
  .seznam > :global(li) {
    content-visibility: auto;
    contain-intrinsic-size: auto 96px;
  }
  .seznam.zkraceny > :global(li:nth-child(n + 61)) {
    display: none;
  }
  .dalsi-btn {
    margin: 1.25rem 0 0;
    text-align: center;
  }
  .prazdno {
    padding: 1.5rem 0;
    color: var(--ink-soft);
  }
  .dalsi {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 2rem 4rem;
    margin-top: clamp(40px, 6vw, 64px);
  }
  .dalsi > div:first-child {
    grid-row: span 2;
  }
  .dalsi > :global(.odber) {
    grid-column: 2;
  }
  .dalsi h2 {
    font-size: 1.75rem;
  }
  .okoli {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2rem;
  }
  .okoli li {
    padding: 0.25rem 0;
  }
  .okoli a {
    font-weight: 600;
    text-decoration: none;
  }
  .okoli a:hover {
    text-decoration: underline;
  }
  .chybi {
    background: var(--mint);
    padding: 1.5rem;
    border-radius: var(--radius);
  }
  @media (max-width: 640px) {
    /* výběry jako vodorovně posuvný pás, ať seznam salonů začíná výš */
    .zamery:not(.zamery--casti) {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 0.25rem;
      scrollbar-width: none;
    }
    .zamery:not(.zamery--casti) a {
      flex: none;
    }
  }
  @media (max-width: 760px) {
    .dalsi {
      grid-template-columns: 1fr;
    }
    .dalsi > div:first-child {
      grid-row: auto;
    }
    .dalsi > :global(.odber) {
      grid-column: auto;
    }
  }
</style>
