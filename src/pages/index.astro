---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Magazin from '../components/Magazin.astro';
import Vybrane from '../components/Vybrane.astro';
import { PROVOZOVNY, nejvetsiMesta, mestoUrl, pocetText, tyden } from '../lib/data';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
// Karty „Nejbližší salon, který…“: čísla z katalogu, „otevřeno teď“ se dopočítá v prohlížeči
const tydny = PROVOZOVNY.map((p) => tyden(p)).filter((t) => !!t);
const cislo = (n: number) => n.toLocaleString('cs-CZ');
const pocetBarber = PROVOZOVNY.filter((p) => p.typ === 'barber').length;
const pocetSobota = tydny.filter((t) => t[5]?.length).length;
const pocetVecer = tydny.filter((t) => t.slice(0, 5).some((d) => d.some(([, k]) => k >= 19 * 60))).length;
const pocetNedele = tydny.filter((t) => t[6]?.length).length;
// Panel „právě teď“: sloupce = počet otevřených salonů v jednotlivých hodinách dne (dopočítá prohlížeč)
const HODINY = Array.from({ length: 16 }, (_, i) => 6 + i); // 6:00–21:00
const ikony = {
  nuzky: 'M6 7a2.5 2.5 0 1 0 0-.01M6 17a2.5 2.5 0 1 0 0-.01M8.2 8.3 19 17M8.2 15.7 19 7',
  kalendar: 'M4 7a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2zM16 3v4M8 3v4M4 11h16',
  mesic: 'M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z',
};
// Výchozí (bez JS) obsah malých karet; skript je podle dne a času přepíše
const volby = [
  { id: 'barber', href: '/okoli/?typ=1', ikona: ikony.nuzky, titul: 'Barbershopy', pod: 'Fade, vousy, břitva', cislo: pocetBarber },
  { id: 'vikend', href: '/okoli/?sobota=1', ikona: ikony.kalendar, titul: 'V sobotu', pod: 'Když přes týden nestíháte', cislo: pocetSobota },
  { id: 'vecer', href: '/okoli/?vecer=1', ikona: ikony.mesic, titul: 'Večer po práci', pod: 'Do 19:00 i déle', cislo: pocetVecer },
];
const pocty = { sobota: pocetSobota, nedele: pocetNedele, vecer: pocetVecer };
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nazev,
    url: SITE.url,
    inLanguage: 'cs',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/hledat/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.nazev,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    email: SITE.email,
  },
];
// Sváteční odkaz od 15. 11. do 2. 1. (web se sestavuje denně)
const _d = new Date();
const sezona = (_d.getMonth() === 10 && _d.getDate() >= 15) || _d.getMonth() === 11 || (_d.getMonth() === 0 && _d.getDate() <= 2);
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Najděte kadeřnictví nebo barbershop kousek od vás: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR. Hned uvidíte, kdo má otevřeno, telefon i cestu. Bez registrace.`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero__in">
      <h1>Kadeřnictví a barbershopy ve vašem okolí</h1>
      <p class="hero__sub">
        {pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR s otevírací dobou, telefonem a cestou. Včetně salonů bez vlastního webu.
      </p>
      <div class="hero__srch"><Hledani /></div>
      <ul class="hero__mesta" aria-label="Často hledaná města">
        {top.slice(0, 8).map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="rychle" aria-labelledby="rychle-h">
    <div class="wrap rychle__in">
      <h2 id="rychle-h" class="sr-only">Právě teď a rychlé hledání v okolí</h2>
      <a class="ted" href="/okoli/?open=1" data-ted>
        <span class="ted__kdy" data-ted-kdy>Podle aktuálního času</span>
        <strong class="ted__titul"><span class="ted__tecka" aria-hidden="true"></span><span data-ted-pocet>Otevřeno teď</span></strong>
        <span class="ted__graf" data-ted-graf aria-hidden="true" hidden>
          {HODINY.map((h) => <span data-h={h}></span>)}
        </span>
        <span class="ted__osa" aria-hidden="true" data-ted-osa hidden><span>6</span><span>9</span><span>12</span><span>15</span><span>18</span><span>21</span></span>
        <span class="ted__pod"><span data-ted-spicka>Salony, kam můžete zajít ještě dnes.</span> <span class="ted__cta">Ukázat v okolí →</span></span>
      </a>
      <ul class="volby">
        {
          volby.map((v) => (
            <li>
              <a href={v.href} class="volba" data-volba={v.id}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={v.ikona} /></svg>
                <span class="volba__txt">
                  <strong data-titul>{v.titul}</strong>
                  <span data-pod>{v.pod}</span>
                </span>
                <span class="volba__cislo" data-cislo>{cislo(v.cislo)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <script type="application/json" id="rychle-tydny" set:html={JSON.stringify(tydny)} />
      <script type="application/json" id="rychle-pocty" set:html={JSON.stringify(pocty)} />
    </div>
    {sezona && <p class="wrap rychle__pozn"><a href="/kadernictvi-o-svatcich/">🎄 Kdo má otevřeno před Vánoci, mezi svátky a na Silvestra →</a></p>}
    <p class="wrap rychle__pozn"><a href="/kdy-se-ostriham/">Plánujete na jindy? Najděte salon otevřený v den a čas, kdy můžete →</a><br />Hledání v okolí použije vaši polohu jen v prohlížeči, nikam ji neukládáme.</p>
  </section>

  <Vybrane />

  <Magazin />

  <section class="section majitel">
    <div class="wrap"><div class="majitel__box">
      <div>
        <h2 class="majitel__h">Máte salon?</h2>
        <p class="majitel__text">Doplňte ceník, fotky a aktuální otevírací dobu. Profil je zdarma a zákazníci vás najdou i bez vlastního webu.</p>
      </div>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div></div>
  </section>

</Base>


<script>
  import { stav, prahaTed } from '../scripts/stav';
  // Panel „právě teď“: živý počet, graf otevřenosti dnes po hodinách a karty podle dne a času
  try {
    type Tyden = [number, number][][];
    const tydny = JSON.parse(document.getElementById('rychle-tydny')!.textContent!) as Tyden[];
    const pocty = JSON.parse(document.getElementById('rychle-pocty')!.textContent!) as Record<string, number>;
    const { den, min } = prahaTed();
    const DNY = ['Pondělí', 'Úterý', 'Středa', 'Čtvrtek', 'Pátek', 'Sobota', 'Neděle'];
    const cz = (n: number) => n.toLocaleString('cs-CZ');
    const $ = (sel: string) => document.querySelector<HTMLElement>(sel)!;

    const otevreno = tydny.filter((t) => stav(t).open).length;
    $('[data-ted-kdy]').textContent = `${DNY[den]} ${Math.floor(min / 60)}:${String(min % 60).padStart(2, '0')}`;
    $('[data-ted-pocet]').textContent = otevreno
      ? `${cz(otevreno)} ${otevreno < 5 ? 'salony mají' : 'salonů má'} otevřeno`
      : 'Teď má většina zavřeno';

    // Kolik salonů má dnes otevřeno v každé hodině (měřeno v půl)
    const sloupce = [...document.querySelectorAll<HTMLElement>('[data-ted-graf] [data-h]')];
    const hodnoty = sloupce.map((el) => {
      const m = Number(el.dataset.h) * 60 + 30;
      return tydny.filter((t) => (t[den] ?? []).some(([a, b]) => m >= a && m < b)).length;
    });
    const max = Math.max(...hodnoty, 1);
    sloupce.forEach((el, i) => {
      el.style.height = `${Math.max(4, (hodnoty[i] / max) * 100)}%`;
      el.title = `${el.dataset.h}:00 · ${hodnoty[i]}`;
      if (Number(el.dataset.h) === Math.floor(min / 60)) el.classList.add('je-ted');
    });
    if (hodnoty.some(Boolean)) {
      $('[data-ted-graf]').hidden = false;
      $('[data-ted-osa]').hidden = false;
      // Špička: souvislý úsek hodin s aspoň 85 % maxima
      const hs = sloupce.map((el) => Number(el.dataset.h)).filter((_, i) => hodnoty[i] >= max * 0.85);
      $('[data-ted-spicka]').textContent = `Dnes je nejvíc otevřeno ${hs[0]}–${hs[hs.length - 1] + 1} h.`;
    } else {
      $('[data-ted-spicka]').textContent = 'Dnes má většina salonů zavřeno.';
    }

    const nastav = (id: string, titul: string, pod: string, pocet: number, href: string) => {
      const a = $(`[data-volba="${id}"]`);
      a.href = href;
      a.querySelector('[data-titul]')!.textContent = titul;
      a.querySelector('[data-pod]')!.textContent = pod;
      a.querySelector('[data-cislo]')!.textContent = cz(pocet);
    };
    // Víkend: v sobotu nabídnout neděli, jinak sobotu
    if (den === 5) nastav('vikend', 'Zítra v neděli', 'Má otevřeno jen málokdo', pocty.nedele, '/okoli/?nedele=1');
    else if (den === 4) nastav('vikend', 'Zítra v sobotu', 'Když přes týden nestíháte', pocty.sobota, '/okoli/?sobota=1');
    // Večer: ve všední den před 19:00 počet salonů otevřených dnes do večera
    if (den <= 4 && min < 19 * 60) {
      const dnesVecer = tydny.filter((t) => (t[den] ?? []).some(([, b]) => b >= 19 * 60)).length;
      if (dnesVecer) nastav('vecer', 'Dnes večer', 'Otevřeno do 19:00 i déle', dnesVecer, '/okoli/?vecer=1');
    }
  } catch {
    /* bez JS zůstanou statické karty */
  }
</script>


<style>
  /* Hero jako na Airbnb: tichá bílá plocha, hledání je hlavní prvek */
  .hero {
    position: relative;
    z-index: 5;
    padding: clamp(32px, 6vw, 72px) 0 clamp(28px, 4vw, 48px);
    text-align: center;
  }
  .hero h1 {
    margin: 0 auto 0.6rem;
    max-width: 24ch;
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .hero__sub {
    margin: 0 auto 2rem;
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.43;
  }
  .hero__srch :global(.srch) {
    margin-inline: auto;
  }
  .hero__mesta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0;
    padding: 0;
    max-width: 52rem;
  }
  .hero__mesta a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .hero__mesta a:active {
    transform: scale(0.96);
  }
  @media (hover: hover) {
    .hero__mesta a:hover {
      border-color: var(--ink);
    }
  }

  /* Panel „právě teď“ + tři menší volby (ploché plochy bez rámečků) */
  .rychle {
    padding: 0 0 8px;
  }
  .rychle__in {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 12px;
  }
  .ted {
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1.5rem;
    background: var(--canvas);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .ted:active {
    transform: scale(0.99);
  }
  .ted__kdy {
    font-size: 0.875rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .ted__titul {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.15rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .ted__tecka {
    position: relative;
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--open);
  }
  .ted__tecka::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--open);
    animation: tecka 2.4s var(--ease-out) infinite;
  }
  @keyframes tecka {
    0% {
      transform: scale(1);
      opacity: 0.5;
    }
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }
  .ted__graf {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    height: 64px;
    margin-top: 1.1rem;
  }
  .ted__graf[hidden],
  .ted__osa[hidden] {
    display: none;
  }
  .ted__graf span {
    flex: 1;
    height: 4%;
    border-radius: 3px 3px 1px 1px;
    background: var(--line-strong);
    transition: height 500ms var(--ease-out);
  }
  .ted__graf span.je-ted {
    background: var(--accent);
  }
  .ted__osa {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    font-size: 0.6875rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .ted__pod {
    margin-top: auto;
    padding-top: 0.9rem;
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .ted__cta {
    color: var(--ink);
    font-weight: 600;
    white-space: nowrap;
  }
  .volby {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .volba {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    min-height: 72px;
    padding: 0.85rem 1.25rem;
    background: var(--canvas);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .volba:active {
    transform: scale(0.98);
  }
  @media (hover: hover) {
    .ted:hover,
    .volba:hover {
      background: var(--line);
      color: var(--ink);
    }
  }
  .volba svg {
    flex: none;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .volba__txt {
    display: grid;
    min-width: 0;
  }
  .volba__txt strong {
    font-size: 1rem;
    font-weight: 600;
  }
  .volba__txt span {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }
  .volba__cislo {
    margin-left: auto;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .rychle__pozn {
    margin: 0.75rem auto 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .rychle__in {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero__mesta li:nth-child(n + 6) {
      display: none;
    }
  }

  .majitel {
    padding-block: 48px;
  }
  .majitel__box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: 2rem clamp(1.25rem, 3vw, 2.5rem);
    background: var(--canvas);
    border-radius: var(--radius);
  }
  .majitel__box > div {
    flex: 1 1 28rem;
  }
  .majitel__h {
    margin: 0 0 0.4rem;
  }
  .majitel__text {
    margin: 0;
    color: var(--ink-soft);
    max-width: 56ch;
  }

</style>
