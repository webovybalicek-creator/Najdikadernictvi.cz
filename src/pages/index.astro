---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Magazin from '../components/Magazin.astro';
import Vybrane from '../components/Vybrane.astro';
import { PROVOZOVNY, nejvetsiMesta, mestoUrl, pocetText, tyden } from '../lib/data';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
// Karty „Nejbližší salon, který…“: čísla z katalogu, „otevřeno teď“ se dopočítá v prohlížeči
const tydny = PROVOZOVNY.map((p) => tyden(p)).filter((t) => !!t);
const cislo = (n: number) => n.toLocaleString('cs-CZ');
const pocetBarber = PROVOZOVNY.filter((p) => p.typ === 'barber').length;
const pocetSobota = tydny.filter((t) => t[5]?.length).length;
const pocetVecer = tydny.filter((t) => t.slice(0, 5).some((d) => d.some(([, k]) => k >= 19 * 60))).length;
const karty = [
  { href: '/okoli/?open=1', cislo: 'Podle aktuálního času', titul: 'Otevřeno teď', popis: 'Salony, kam můžete zajít ještě dnes', zive: true },
  { href: '/okoli/?typ=1', cislo: `${cislo(pocetBarber)} salonů`, titul: 'Barbershopy', popis: 'Fade, úprava vousů, holení břitvou' },
  { href: '/okoli/?sobota=1', cislo: `${cislo(pocetSobota)} salonů`, titul: 'Otevřeno v sobotu', popis: 'Když přes týden nestíháte' },
  { href: '/okoli/?vecer=1', cislo: `${cislo(pocetVecer)} salonů`, titul: 'Otevřeno večer', popis: 'Po práci, do 19:00 i déle' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nazev,
    url: SITE.url,
    inLanguage: 'cs',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/hledat/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.nazev,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    email: SITE.email,
  },
];
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Najděte kadeřnictví nebo barbershop kousek od vás: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR. Hned uvidíte, kdo má otevřeno, telefon i cestu. Bez registrace.`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero__in">
      <h1>Kadeřnictví a barbershopy ve vašem okolí</h1>
      <p class="hero__sub">
        {pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR s otevírací dobou, telefonem a cestou. Včetně salonů bez vlastního webu.
      </p>
      <div class="hero__srch"><Hledani /></div>
      <ul class="hero__mesta" aria-label="Často hledaná města">
        {top.slice(0, 8).map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="rychle" aria-labelledby="rychle-h">
    <div class="wrap">
      <h2 id="rychle-h" class="sr-only">Rychlé hledání v okolí</h2>
      <ul class="rychle__list">
        {
          karty.map((k) => (
            <li>
              <a href={k.href} class="rk">
                <span class="rk__cislo" data-zive={k.zive ? '' : undefined}>{k.cislo}</span>
                <strong class="rk__titul">{k.titul}</strong>
                <span class="rk__popis">{k.popis}</span>
                <span class="rk__sipka" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <script type="application/json" id="rychle-tydny" set:html={JSON.stringify(tydny)} />
      <p class="rychle__pozn">Hledání v okolí použije vaši polohu jen v prohlížeči, nikam ji neukládáme.</p>
    </div>
  </section>

  <Vybrane />

  <Magazin />

  <section class="section majitel">
    <div class="wrap"><div class="majitel__box">
      <div>
        <h2 class="majitel__h">Máte salon?</h2>
        <p class="majitel__text">Doplňte ceník, fotky a aktuální otevírací dobu. Profil je zdarma a zákazníci vás najdou i bez vlastního webu.</p>
      </div>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div></div>
  </section>

</Base>


<script>
  import { stav } from '../scripts/stav';
  // Živý počet salonů, které mají právě otevřeno
  try {
    const el = document.querySelector<HTMLElement>('.rk__cislo[data-zive]');
    const data = document.getElementById('rychle-tydny')?.textContent;
    if (el && data) {
      const n = (JSON.parse(data) as [number, number][][][]).filter((t) => stav(t).open).length;
      if (n) el.textContent = `${n.toLocaleString('cs-CZ')} má otevřeno`;
    }
  } catch {
    /* bez živého počtu zůstane statický štítek */
  }
</script>


<style>
  /* Hero jako na Airbnb: tichá bílá plocha, hledání je hlavní prvek */
  .hero {
    position: relative;
    z-index: 5;
    padding: clamp(32px, 6vw, 72px) 0 clamp(28px, 4vw, 48px);
    text-align: center;
  }
  .hero h1 {
    margin: 0 auto 0.6rem;
    max-width: 24ch;
    font-size: clamp(1.75rem, 3.4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .hero__sub {
    margin: 0 auto 2rem;
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.43;
  }
  .hero__srch :global(.srch) {
    margin-inline: auto;
  }
  .hero__mesta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 1.5rem auto 0;
    padding: 0;
    max-width: 52rem;
  }
  .hero__mesta a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      border-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .hero__mesta a:active {
    transform: scale(0.96);
  }
  @media (hover: hover) {
    .hero__mesta a:hover {
      border-color: var(--ink);
    }
  }

  /* Rychlé volby: ploché dlaždice na šedém plátně, bez rámečků */
  .rychle {
    padding: 0 0 8px;
  }
  .rychle__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }
  .rk {
    position: relative;
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 1.25rem 2.75rem 1.25rem 1.25rem;
    background: var(--canvas);
    border-radius: var(--radius);
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 150ms var(--ease-out),
      transform 160ms var(--ease-out);
  }
  .rk:active {
    transform: scale(0.98);
  }
  @media (hover: hover) {
    .rk:hover {
      background: var(--line);
      color: var(--ink);
    }
    .rk:hover .rk__sipka {
      transform: translateX(3px);
    }
  }
  .rk__cislo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .rk__cislo[data-zive]::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--open);
  }
  .rk__titul {
    font-size: 1rem;
    font-weight: 600;
  }
  .rk__popis {
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.43;
  }
  .rk__sipka {
    position: absolute;
    right: 1.1rem;
    top: 50%;
    margin-top: -0.7em;
    color: var(--ink);
    transition: transform 200ms var(--ease-out);
  }
  .rychle__pozn {
    margin: 0.75rem 0 0;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .rychle__list {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
  }
  @media (max-width: 640px) {
    .hero__mesta li:nth-child(n + 6) {
      display: none;
    }
    .rk {
      padding: 1rem 2.25rem 1rem 1rem;
    }
    .rk__popis {
      display: none;
    }
  }

  .majitel {
    padding-block: 48px;
  }
  .majitel__box {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: 2rem clamp(1.25rem, 3vw, 2.5rem);
    background: var(--canvas);
    border-radius: var(--radius);
  }
  .majitel__box > div {
    flex: 1 1 28rem;
  }
  .majitel__h {
    margin: 0 0 0.4rem;
  }
  .majitel__text {
    margin: 0;
    color: var(--ink-soft);
    max-width: 56ch;
  }

</style>
