---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Magazin from '../components/Magazin.astro';
import Vybrane from '../components/Vybrane.astro';
import { KRAJE } from '../lib/kraje';
import { Picture } from 'astro:assets';
import { PROVOZOVNY, nejvetsiMesta, krajUrl, mestoUrl, pocetText, tyden } from '../lib/data';
import fotoOtevreno from '../assets/blog/salon-cihly.jpg';
import fotoBarber from '../assets/blog/barbershop-interier.jpg';
import fotoSobota from '../assets/blog/barber-kreslo-slunce.jpg';
import fotoVecer from '../assets/blog/barbershop-noc.jpg';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
// Karty „Nejbližší salon, který…“: čísla z katalogu, „otevřeno teď“ se dopočítá v prohlížeči
const tydny = PROVOZOVNY.map((p) => tyden(p)).filter((t) => !!t);
const cislo = (n: number) => n.toLocaleString('cs-CZ');
const karty = [
  { href: '/okoli/?open=1', foto: fotoOtevreno, titul: 'má otevřeno teď', popis: 'Ostříhat se ještě dnes', stitek: `${cislo(tydny.length)} salonů se známou otevírací dobou`, zive: true },
  { href: '/okoli/?typ=1', foto: fotoBarber, titul: 'je barbershop', popis: 'Fade, vousy a holení břitvou', stitek: `${cislo(PROVOZOVNY.filter((p) => p.typ === 'barber').length)} barbershopů` },
  { href: '/okoli/?sobota=1', foto: fotoSobota, titul: 'má otevřeno v sobotu', popis: 'Když přes týden nestíháte', stitek: `${cislo(tydny.filter((t) => t[5]?.length).length)} salonů v sobotu` },
  { href: '/okoli/?vecer=1', foto: fotoVecer, titul: 'má otevřeno večer', popis: 'Po práci, do 19:00 i déle', stitek: `${cislo(tydny.filter((t) => t.slice(0, 5).some((d) => d.some(([, k]) => k >= 19 * 60))).length)} salonů večer` },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nazev,
    url: SITE.url,
    inLanguage: 'cs',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/hledat/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.nazev,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    email: SITE.email,
  },
];
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Najděte kadeřnictví nebo barbershop kousek od vás: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR. Hned uvidíte, kdo má otevřeno, telefon i cestu. Bez registrace.`}
  jsonLd={jsonLd}
>
  <section class="hero" data-fen>
    <div class="wrap hero__in">
      <h1>Najděte svého <em>kadeřníka</em></h1>
      <p class="hero__sub">Kadeřnictví a barbershopy v celé České republice, i ty bez vlastního webu.</p>
      <div class="hero__srch"><Hledani /></div>
      <ul class="hero__mesta" aria-label="Nejčastěji hledaná města">
        {top.slice(0, 8).map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
    </div>
  </section>

  <Vybrane />

  <section class="rychle" aria-labelledby="rychle-h">
    <div class="wrap">
      <h2 id="rychle-h" class="rychle__h">Nejbližší salon, který…</h2>
      <ul class="rychle__list">
        {
          karty.map((k) => (
            <li>
              <a href={k.href} class="rk">
                <Picture src={k.foto} alt="" widths={[360, 560, 720]} sizes="(max-width: 640px) 80vw, (max-width: 1000px) 45vw, 270px" formats={['avif', 'webp']} loading="lazy" class="rk__foto" />
                <span class="rk__stitek" data-zive={k.zive ? '' : undefined}>{k.stitek}</span>
                <span class="rk__text">
                  <strong>{k.titul}</strong>
                  <span>{k.popis}</span>
                </span>
                <i class="rk__sipka" aria-hidden="true">→</i>
              </a>
            </li>
          ))
        }
      </ul>
      <script type="application/json" id="rychle-tydny" set:html={JSON.stringify(tydny)} />
      <p class="rychle__pozn">Použijeme vaši polohu jen v prohlížeči, nikam ji neukládáme.</p>
    </div>
  </section>


  <Magazin />

  <section class="section majitel">
    <div class="wrap">
      <p class="majitel__citat">
        Máte salon? Doplňte <em>ceník, fotky</em> a aktuální otevírací dobu. Zákazníci vás najdou i bez vlastního webu.
      </p>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div>
  </section>

  <nav class="rozcestnik" aria-label="Kadeřnictví podle měst a krajů">
    <div class="wrap">
      <p class="rozcestnik__h">Kadeřnictví podle měst</p>
      <ul>
        {top.map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
      <p class="rozcestnik__h">Podle krajů</p>
      <ul>
        {KRAJE.map((k) => <li><a href={krajUrl(k.slug)}>{k.nazev}</a></li>)}
      </ul>
    </div>
  </nav>
</Base>


<script>
  import { stav } from '../scripts/stav';
  // Živý počet salonů, které mají právě otevřeno
  try {
    const el = document.querySelector<HTMLElement>('.rk__stitek[data-zive]');
    const data = document.getElementById('rychle-tydny')?.textContent;
    if (el && data) {
      const n = (JSON.parse(data) as [number, number][][][]).filter((t) => stav(t).open).length;
      el.textContent = n ? `${n.toLocaleString('cs-CZ')} má teď otevřeno` : 'Teď je většina zavřená, ukážeme kdy otevírají';
    }
  } catch {
    /* bez živého počtu zůstane statický štítek */
  }
</script>

<script>
  import { fen } from '../scripts/fen';
  const heroFen = document.querySelector<HTMLElement>('[data-fen]');
  if (heroFen) fen(heroFen);
</script>

<style>
  .rychle {
    padding: clamp(32px, 5vw, 56px) 0 0;
  }
  .rychle__h {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0 0 1rem;
  }
  .rychle__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .rk {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    isolation: isolate;
    background: #222;
  }
  .rk :global(.rk__foto),
  .rk :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: transform 0.5s ease;
  }
  .rk::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 30%, rgba(0, 0, 0, 0.78) 100%);
  }
  .rk:hover :global(img) {
    transform: scale(1.06);
  }
  .rk__stitek {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    right: 0.85rem;
    width: fit-content;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .rk__stitek[data-zive]::before {
    content: '';
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: var(--open);
    vertical-align: 0.05em;
  }
  .rk__text {
    position: absolute;
    left: 1.1rem;
    right: 3.2rem;
    bottom: 1.1rem;
    display: grid;
    gap: 0.2rem;
  }
  .rk__text strong {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.15;
  }
  .rk__text span {
    font-size: 0.85rem;
    opacity: 0.85;
  }
  .rk__sipka {
    position: absolute;
    right: 1rem;
    bottom: 1.1rem;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: var(--accent);
    font-style: normal;
    transition: transform 0.2s;
  }
  .rk:hover .rk__sipka {
    transform: translateX(3px);
  }
  .rychle__pozn {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .rychle__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: calc(68px + 28px) 0 12px !important;
    }
    .hero h1 {
      font-size: 2.5rem !important;
      margin-top: 40px !important;
      margin-bottom: 1.1rem !important;
    }
    .hero__sub {
      font-size: 0.95rem !important;
      margin-bottom: 1.25rem !important;
    }
    .hero__mesta li:nth-child(n + 7) {
      display: none;
    }
    .rychle {
      padding-top: 24px;
    }
    .rychle__list {
      grid-template-columns: none !important;
      grid-auto-flow: column;
      grid-auto-columns: 72%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin: 0 calc(-1 * var(--gutter));
      padding: 0 var(--gutter) 4px;
      gap: 0.6rem;
    }
    .rychle__list li {
      scroll-snap-align: start;
    }
    .rk {
      aspect-ratio: 3 / 4;
    }
  }
  .rozcestnik {
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .rozcestnik__h {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rozcestnik ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .rozcestnik ul:last-child {
    margin-bottom: 0;
  }
  .rozcestnik a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .rozcestnik a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .hero {
    position: relative;
    z-index: 5;
    isolation: isolate;
    /* + výška průhledné hlavičky, která je nad úvodem */
    padding: calc(68px + clamp(48px, 9vw, 110px)) 0 clamp(16px, 2.5vw, 28px);
    text-align: center;
  }
  /* Jemný rozmazaný teplý gradient za úvodem */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -10% -10% 0;
    background:
      radial-gradient(38% 45% at 22% 30%, rgb(255 122 50 / 0.42), transparent 70%),
      radial-gradient(32% 42% at 78% 22%, rgb(255 184 77 / 0.5), transparent 70%),
      radial-gradient(30% 38% at 62% 72%, rgb(255 95 70 / 0.22), transparent 70%);
    filter: blur(30px);
    transform: translate(var(--fx, 0px), var(--fy, 0px));
    will-change: transform;
  }
  .hero :global(.hero__fen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 5.6vw, 3.6rem);
    line-height: 1.05;
    margin: 100px auto 1.6rem;
    max-width: 16ch;
  }
  .hero__sub {
    margin: 0 auto 2.25rem;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
  .hero__srch {
    max-width: 44rem;
    margin: 0 auto;
    text-align: left;
  }
  .hero__srch :global(.srch) {
    max-width: none;
  }
  .hero__mesta {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .hero__mesta a {
    display: inline-block;
    padding: 0.4em 1em;
    border: 1px solid rgb(20 20 20 / 0.08);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }
  .hero__mesta a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .o-webu {
    background: var(--mint);
  }
  .dva,
  .o-webu__in {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 1.5rem 3rem;
    align-items: start;
  }
  .dva > .eyebrow,
  .o-webu__in > .eyebrow {
    margin-top: 0.6rem;
  }
  .o-webu__text {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.3;
    max-width: 34ch;
    margin-bottom: 2.5rem;
  }
  .cisla {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin: 0;
  }
  .cisla div {
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }
  .cisla dt {
    font-family: var(--f-display);
    font-size: 1.8rem;
    line-height: 1.1;
  }
  .cisla dd {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .alt {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .mesta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    column-gap: 2rem;
  }
  .mesta a {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .mesta a:hover span:first-child {
    text-decoration: underline;
  }
  .mesta__praha summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
  }
  .mesta__praha summary::-webkit-details-marker {
    display: none;
  }
  .mesta__praha summary span:first-child::after {
    content: '';
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.55em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.2em) rotate(45deg);
    transition: transform 0.2s;
  }
  .mesta__praha details[open] summary span:first-child::after {
    transform: translateY(0.05em) rotate(-135deg);
  }
  .mesta__praha ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--line);
  }
  .mesta__praha ul a {
    padding: 0.45rem 0;
    font-size: 0.88rem;
  }
  .kraje {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
  }
  .kraje li {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
    font-size: 0.95rem;
  }
  .kraje a {
    text-decoration: none;
  }
  .kraje a:hover {
    text-decoration: underline;
  }

  .majitel .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
    background: #17171a;
    color: #fff;
    border-radius: 24px;
    width: calc(100% - 2 * var(--gutter));
    max-width: calc(var(--wrap) - 2 * var(--gutter));
  }
  .majitel__citat {
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 30ch;
    margin: 0;
  }
  .majitel__citat em {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .majitel .btn {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
  }

  @media (max-width: 760px) {
    .dva,
    .o-webu__in {
      grid-template-columns: 1fr;
    }
    .cisla {
      grid-template-columns: repeat(2, 1fr);
    }
    .kraje {
      columns: 1;
    }
  }
</style>
