---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Karta from '../components/Karta.astro';
import Magazin from '../components/Magazin.astro';
import { KRAJE } from '../lib/kraje';
import { PROVOZOVNY, nejvetsiMesta, pocetVKraji, krajUrl, mestoUrl, mestaSloucena, pocetText, vyber } from '../lib/data';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
const doporucene = vyber(PROVOZOVNY.filter((p) => p.typ === 'kadernictvi'), 8);
const barbershopy = vyber(PROVOZOVNY.filter((p) => p.typ === 'barber'), 4);
const pocetBarberu = PROVOZOVNY.filter((p) => p.typ === 'barber').length;
const pocetObci = mestaSloucena().length;
const cislo = (n: number) => n.toLocaleString('cs-CZ');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nazev,
    url: SITE.url,
    inLanguage: 'cs',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/hledat/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.nazev,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    email: SITE.email,
  },
];
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Kadeřnictví a barbershopy v celé ČR na jednom místě: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} s adresou, telefonem, otevírací dobou a mapou.`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero__in">
      <h1>Najděte svého <em>kadeřníka</em></h1>
      <p class="hero__sub">Kadeřnictví a barbershopy v celé České republice, i ty bez vlastního webu.</p>
      <div class="hero__srch"><Hledani /></div>
      <ul class="hero__mesta" aria-label="Nejčastěji hledaná města">
        {top.slice(0, 8).map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
    </div>
  </section>

  <section class="section o-webu">
    <div class="wrap o-webu__in">
      <span class="eyebrow">O webu</span>
      <div>
        <p class="o-webu__text">
          Katalog kadeřnictví a barbershopů s adresou, kontaktem a otevírací dobou na jednom místě. Bez registrace, bez
          reklamních profilů.
        </p>
        <dl class="cisla">
          <div><dt>{cislo(PROVOZOVNY.length)}</dt><dd>salonů v katalogu</dd></div>
          <div><dt>{cislo(pocetObci)}</dt><dd>obcí a městských částí</dd></div>
          <div><dt>{cislo(pocetBarberu)}</dt><dd>barbershopů</dd></div>
          <div><dt>14</dt><dd>krajů celé ČR</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <Magazin />

  {
    doporucene.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <h2>Salony s kompletními údaji</h2>
              <p class="muted">Otevírací doba, telefon i web na jednom místě.</p>
            </div>
            <a class="btn" href="/kraje/">Všechny salony</a>
          </div>
          <ul class="karty">
            {doporucene.map((p) => <Karta p={p} />)}
          </ul>
        </div>
      </section>
    )
  }

  {
    barbershopy.length > 0 && (
      <section class="section alt">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <h2>Barbershopy</h2>
              <p class="muted">Střih, fade a péče o vousy.</p>
            </div>
          </div>
          <ul class="karty">
            {barbershopy.map((p) => <Karta p={p} />)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap dva">
      <span class="eyebrow">Podle města</span>
      <div>
        <h2>Největší města</h2>
        <ul class="mesta">
          {
            top.map((m) =>
              m.obvody ? (
                <li class="mesta__praha">
                  <details>
                    <summary>
                      <span>{m.nazev}</span>
                      <span class="muted">{m.provozovny.length}</span>
                    </summary>
                    <ul>
                      <li>
                        <a href={mestoUrl(m.slug)}>
                          <span>Celá Praha</span>
                        </a>
                      </li>
                      {m.obvody.map((o) => (
                        <li>
                          <a href={mestoUrl(o.slug)}>
                            <span>{o.nazev}</span>
                            <span class="muted">{o.provozovny.length}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </details>
                </li>
              ) : (
                <li>
                  <a href={mestoUrl(m.slug)}>
                    <span>{m.nazev}</span>
                    <span class="muted">{m.provozovny.length}</span>
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap dva">
      <span class="eyebrow">Celá ČR</span>
      <div>
        <h2>Podle kraje</h2>
        <ol class="kraje">
          {
            KRAJE.map((k) => (
              <li>
                <a href={krajUrl(k.slug)}>{k.nazev}</a>
                <span class="muted">{pocetVKraji(k.slug)}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="section majitel">
    <div class="wrap">
      <p class="majitel__citat">
        Máte salon? Doplňte <em>ceník, fotky</em> a aktuální otevírací dobu. Zákazníci vás najdou i bez vlastního webu.
      </p>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div>
  </section>
</Base>


<style>
  .hero {
    padding: clamp(56px, 11vw, 140px) 0 clamp(56px, 9vw, 112px);
    text-align: center;
    border-bottom: 1px solid var(--line);
  }
  .hero h1 {
    font-size: clamp(2.8rem, 8vw, 5.4rem);
    line-height: 1;
    margin: 0 auto 1.25rem;
    max-width: 14ch;
  }
  .hero__sub {
    margin: 0 auto 2.25rem;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
  .hero__srch {
    max-width: 38rem;
    margin: 0 auto;
    text-align: left;
  }
  .hero__srch :global(.srch) {
    max-width: none;
  }
  .hero__mesta {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .hero__mesta a {
    display: inline-block;
    padding: 0.35em 0.9em;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink-soft);
  }
  .hero__mesta a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .o-webu {
    background: var(--mint);
  }
  .dva,
  .o-webu__in {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 1.5rem 3rem;
    align-items: start;
  }
  .dva > .eyebrow,
  .o-webu__in > .eyebrow {
    margin-top: 0.6rem;
  }
  .o-webu__text {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.3;
    max-width: 34ch;
    margin-bottom: 2.5rem;
  }
  .cisla {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin: 0;
  }
  .cisla div {
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }
  .cisla dt {
    font-family: var(--f-display);
    font-size: 1.8rem;
    line-height: 1.1;
  }
  .cisla dd {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .alt {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .mesta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    column-gap: 2rem;
  }
  .mesta a {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .mesta a:hover span:first-child {
    text-decoration: underline;
  }
  .mesta__praha summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
  }
  .mesta__praha summary::-webkit-details-marker {
    display: none;
  }
  .mesta__praha summary span:first-child::after {
    content: '';
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.55em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.2em) rotate(45deg);
    transition: transform 0.2s;
  }
  .mesta__praha details[open] summary span:first-child::after {
    transform: translateY(0.05em) rotate(-135deg);
  }
  .mesta__praha ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--line);
  }
  .mesta__praha ul a {
    padding: 0.45rem 0;
    font-size: 0.88rem;
  }
  .kraje {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
  }
  .kraje li {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
    font-size: 0.95rem;
  }
  .kraje a {
    text-decoration: none;
  }
  .kraje a:hover {
    text-decoration: underline;
  }

  .majitel {
    text-align: center;
  }
  .majitel__citat {
    font-family: var(--f-display);
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.3;
    max-width: 30ch;
    margin: 0 auto 2rem;
  }

  @media (max-width: 760px) {
    .dva,
    .o-webu__in {
      grid-template-columns: 1fr;
    }
    .cisla {
      grid-template-columns: repeat(2, 1fr);
    }
    .kraje {
      columns: 1;
    }
  }
</style>
