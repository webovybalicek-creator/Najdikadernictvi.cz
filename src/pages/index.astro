---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Karta from '../components/Karta.astro';
import Tipy from '../components/Tipy.astro';
import { KRAJE } from '../lib/kraje';
import { PROVOZOVNY, nejvetsiMesta, pocetVKraji, krajUrl, mestoUrl, mesta, pocetText, vyber } from '../lib/data';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
const doporucene = vyber(PROVOZOVNY.filter((p) => p.typ === 'kadernictvi'), 8);
const barbershopy = vyber(PROVOZOVNY.filter((p) => p.typ === 'barber'), 4);
const pocetBarberu = PROVOZOVNY.filter((p) => p.typ === 'barber').length;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nazev,
  url: SITE.url,
  inLanguage: 'cs',
};
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Kadeřnictví a barbershopy v celé ČR na jednom místě: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} s adresou, telefonem, otevírací dobou a mapou.`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero__in">
      <h1>Kadeřnictví a barbery<br />najdeš tady</h1>
      <p class="hero__sub">
        {pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v {pocetText(mesta().length, 'obci', 'obcích', 'obcích')} po celé
        republice. Adresa, telefon a otevírací doba, i když salon nemá vlastní web.
      </p>
      <Hledani />
      <ul class="hero__mesta" aria-label="Nejčastěji hledaná města">
        {top.slice(0, 8).map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
    </div>
    <div class="hero__pole" aria-hidden="true"></div>
  </section>

  {
    doporucene.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <span class="eyebrow">Kompletní profily</span>
              <h2>Kadeřnictví s kompletními údaji</h2>
            </div>
          </div>
          <ul class="karty">
            {doporucene.map((p) => <Karta p={p} />)}
          </ul>
        </div>
      </section>
    )
  }

  {
    barbershopy.length > 0 && (
      <section class="section barber-sec">
        <div class="wrap">
          <div class="sec-head">
            <div>
              <span class="eyebrow">Pro pány</span>
              <h2>Barbershopy</h2>
            </div>
            <p class="muted">Střih, fade a péče o vousy.</p>
          </div>
          <ul class="karty">
            {barbershopy.map((p) => <Karta p={p} />)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <span class="eyebrow">Podle města</span>
      <h2>Největší města</h2>
      <ul class="mesta">
        {
          top.map((m) => (
            <li>
              <a href={mestoUrl(m.slug)}>
                <span>{m.nazev}</span>
                <span class="muted">{m.provozovny.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section kraje-sec">
    <div class="wrap kraje-grid">
      <div>
        <span class="eyebrow">Celá ČR</span>
        <h2>Podle kraje</h2>
        <p class="muted">
          Vyber kraj a uvidíš všechny obce, kde máme kadeřnictví nebo barbershop. Z toho je{' '}
          {pocetText(pocetBarberu, 'barbershop', 'barbershopy', 'barbershopů')}.
        </p>
      </div>
      <ol class="kraje">
        {
          KRAJE.map((k) => (
            <li>
              <a href={krajUrl(k.slug)}>{k.nazev}</a>
              <span class="muted">{pocetVKraji(k.slug)}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Tipy />

  <section class="section">
    <div class="wrap majitel">
      <div>
        <h2>Máte salon?</h2>
        <p>
          Doplňte ceník, fotky a aktuální otevírací dobu. Profil je zdarma a zákazníci vás najdou i bez vlastního
          webu.
        </p>
      </div>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    background: var(--bottle);
    color: var(--bottle-ink);
    padding: clamp(48px, 9vw, 104px) 0 clamp(64px, 10vw, 120px);
    overflow: hidden;
  }
  .hero h1 {
    font-size: clamp(3rem, 9.5vw, 7rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.005em;
    margin-bottom: 1.5rem;
    max-width: 12ch;
  }
  .hero__sub {
    font-size: 1.15rem;
    opacity: 0.9;
    max-width: 40rem;
    margin-bottom: 1.75rem;
  }
  .hero :global(.btn) {
    background: var(--brass);
    border-color: var(--brass);
    color: #1b1408;
  }
  .hero :global(input) {
    border-color: transparent;
  }
  .hero__mesta {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.95rem;
  }
  .hero__mesta a {
    color: var(--bottle-ink);
    opacity: 0.85;
  }
  .hero__mesta a:hover {
    opacity: 1;
  }
  /* Pruhy holičské tyče – jediný dekorativní prvek webu */
  .hero__pole {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 18px;
    background: repeating-linear-gradient(
      -45deg,
      var(--paper) 0 14px,
      var(--brass) 14px 28px,
      var(--paper) 28px 42px,
      #2b5f8a 42px 56px
    );
  }

  .barber-sec {
    background: var(--ink);
    color: var(--paper);
    --ink-soft: color-mix(in srgb, var(--paper) 70%, transparent);
  }
  .barber-sec :global(.karta__typ) {
    color: var(--brass);
  }
  .mesta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    column-gap: 2rem;
  }
  .mesta a {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-weight: 600;
  }
  .mesta a:hover span:first-child {
    text-decoration: underline;
  }

  .kraje-sec {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .kraje-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem 4rem;
  }
  .kraje {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
  }
  .kraje li {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
  }
  .kraje a {
    font-weight: 600;
    text-decoration: none;
  }
  .kraje a:hover {
    text-decoration: underline;
  }

  .majitel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
  }
  .majitel p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .kraje-grid {
      grid-template-columns: 1fr;
    }
    .kraje {
      columns: 1;
    }
    .hero__sub {
      font-size: 1.05rem;
    }
  }
  @media (max-width: 480px) {
    .hero :global(.srch) {
      flex-direction: column;
    }
  }
</style>
