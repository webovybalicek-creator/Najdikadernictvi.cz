---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Magazin from '../components/Magazin.astro';
import Vybrane from '../components/Vybrane.astro';
import { KRAJE } from '../lib/kraje';
import { PROVOZOVNY, nejvetsiMesta, krajUrl, mestoUrl, pocetText } from '../lib/data';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nazev,
    url: SITE.url,
    inLanguage: 'cs',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/hledat/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.nazev,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    email: SITE.email,
  },
];
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Najděte kadeřnictví nebo barbershop kousek od vás: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR. Hned uvidíte, kdo má otevřeno, telefon i cestu. Bez registrace.`}
  jsonLd={jsonLd}
>
  <section class="hero" data-fen>
    <div class="wrap hero__in">
      <h1>Najděte svého <em>kadeřníka</em></h1>
      <p class="hero__sub">Kadeřnictví a barbershopy v celé České republice, i ty bez vlastního webu.</p>
      <div class="hero__srch"><Hledani /></div>
      <ul class="hero__mesta" aria-label="Nejčastěji hledaná města">
        {top.slice(0, 8).map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
    </div>
  </section>

  <Vybrane />

  <section class="rychle" aria-labelledby="rychle-h">
    <div class="wrap">
      <h2 id="rychle-h" class="rychle__h">Nejbližší salon, který…</h2>
      <ul class="rychle__list">
        <li><a href="/okoli/?open=1"><i aria-hidden="true">⏱</i><strong>má otevřeno teď</strong><span>Podle otevírací doby salonů</span></a></li>
        <li><a href="/okoli/?typ=1"><i aria-hidden="true">✂</i><strong>je barbershop</strong><span>Střih, fade a úprava vousů</span></a></li>
        <li><a href="/okoli/?sobota=1"><i aria-hidden="true">☀</i><strong>má otevřeno v sobotu</strong><span>Když přes týden nestíháte</span></a></li>
        <li><a href="/okoli/?detske=1"><i aria-hidden="true">★</i><strong>stříhá děti</strong><span>Salony s dětskými střihy</span></a></li>
      </ul>
      <p class="rychle__pozn">Použijeme vaši polohu jen v prohlížeči, nikam ji neukládáme.</p>
    </div>
  </section>


  <Magazin />

  <section class="section majitel">
    <div class="wrap">
      <p class="majitel__citat">
        Máte salon? Doplňte <em>ceník, fotky</em> a aktuální otevírací dobu. Zákazníci vás najdou i bez vlastního webu.
      </p>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div>
  </section>

  <nav class="rozcestnik" aria-label="Kadeřnictví podle měst a krajů">
    <div class="wrap">
      <p class="rozcestnik__h">Kadeřnictví podle měst</p>
      <ul>
        {top.map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
      <p class="rozcestnik__h">Podle krajů</p>
      <ul>
        {KRAJE.map((k) => <li><a href={krajUrl(k.slug)}>{k.nazev}</a></li>)}
      </ul>
    </div>
  </nav>
</Base>


<script>
  import { fen } from '../scripts/fen';
  const heroFen = document.querySelector<HTMLElement>('[data-fen]');
  if (heroFen) fen(heroFen);
</script>

<style>
  .rychle {
    padding: clamp(32px, 5vw, 56px) 0 0;
  }
  .rychle__h {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    margin: 0 0 1rem;
  }
  .rychle__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .rychle__list i {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    font-style: normal;
    font-size: 1.25rem;
  }
  .rychle__list a {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    height: 100%;
    padding: 1.1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s, transform 0.15s;
  }
  .rychle__list a:hover {
    border-color: var(--ink);
    transform: translateY(-2px);
  }
  .rychle__list strong {
    flex: 1;
    min-width: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .rychle__list span {
    flex-basis: 100%;
    margin-top: -0.25rem;
    padding-left: calc(2.75rem + 0.9rem);
    font-size: 0.82rem;
    color: var(--ink-soft);
  }
  .rychle__pozn {
    margin: 0.75rem 0 0;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .rychle__list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: calc(68px + 28px) 0 12px !important;
    }
    .hero h1 {
      font-size: 2.5rem !important;
      margin-top: 40px !important;
      margin-bottom: 1.1rem !important;
    }
    .hero__sub {
      font-size: 0.95rem !important;
      margin-bottom: 1.25rem !important;
    }
    .hero__mesta li:nth-child(n + 7) {
      display: none;
    }
    .rychle {
      padding-top: 24px;
    }
    .rychle__list {
      grid-template-columns: 1fr !important;
      gap: 0.5rem;
    }
    .rychle__list a {
      padding: 0.7rem 0.9rem;
    }
    .rychle__list i {
      width: 2.4rem;
      height: 2.4rem;
      font-size: 1.1rem;
    }
    .rychle__list span {
      display: none;
    }
  }
  .rozcestnik {
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .rozcestnik__h {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .rozcestnik ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .rozcestnik ul:last-child {
    margin-bottom: 0;
  }
  .rozcestnik a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .rozcestnik a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .hero {
    position: relative;
    z-index: 5;
    isolation: isolate;
    /* + výška průhledné hlavičky, která je nad úvodem */
    padding: calc(68px + clamp(48px, 9vw, 110px)) 0 clamp(16px, 2.5vw, 28px);
    text-align: center;
  }
  /* Jemný rozmazaný teplý gradient za úvodem */
  .hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -10% -10% 0;
    background:
      radial-gradient(38% 45% at 22% 30%, rgb(255 122 50 / 0.42), transparent 70%),
      radial-gradient(32% 42% at 78% 22%, rgb(255 184 77 / 0.5), transparent 70%),
      radial-gradient(30% 38% at 62% 72%, rgb(255 95 70 / 0.22), transparent 70%);
    filter: blur(30px);
    transform: translate(var(--fx, 0px), var(--fy, 0px));
    will-change: transform;
  }
  .hero :global(.hero__fen) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    pointer-events: none;
  }
  .hero h1 {
    font-size: clamp(2.3rem, 5.6vw, 3.6rem);
    line-height: 1.05;
    margin: 100px auto 1.6rem;
    max-width: 16ch;
  }
  .hero__sub {
    margin: 0 auto 2.25rem;
    color: var(--ink-soft);
    font-size: 1.1rem;
  }
  .hero__srch {
    max-width: 44rem;
    margin: 0 auto;
    text-align: left;
  }
  .hero__srch :global(.srch) {
    max-width: none;
  }
  .hero__mesta {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }
  .hero__mesta a {
    display: inline-block;
    padding: 0.4em 1em;
    border: 1px solid rgb(20 20 20 / 0.08);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    text-decoration: none;
    color: var(--ink);
    font-weight: 500;
  }
  .hero__mesta a:hover {
    border-color: var(--ink);
    color: var(--ink);
  }

  .o-webu {
    background: var(--mint);
  }
  .dva,
  .o-webu__in {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 1.5rem 3rem;
    align-items: start;
  }
  .dva > .eyebrow,
  .o-webu__in > .eyebrow {
    margin-top: 0.6rem;
  }
  .o-webu__text {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    line-height: 1.3;
    max-width: 34ch;
    margin-bottom: 2.5rem;
  }
  .cisla {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin: 0;
  }
  .cisla div {
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }
  .cisla dt {
    font-family: var(--f-display);
    font-size: 1.8rem;
    line-height: 1.1;
  }
  .cisla dd {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }

  .alt {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .mesta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    column-gap: 2rem;
  }
  .mesta a {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .mesta a:hover span:first-child {
    text-decoration: underline;
  }
  .mesta__praha summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
  }
  .mesta__praha summary::-webkit-details-marker {
    display: none;
  }
  .mesta__praha summary span:first-child::after {
    content: '';
    display: inline-block;
    width: 0.4em;
    height: 0.4em;
    margin-left: 0.55em;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.2em) rotate(45deg);
    transition: transform 0.2s;
  }
  .mesta__praha details[open] summary span:first-child::after {
    transform: translateY(0.05em) rotate(-135deg);
  }
  .mesta__praha ul {
    list-style: none;
    margin: 0;
    padding: 0 0 0 0.9rem;
    border-left: 1px solid var(--line);
  }
  .mesta__praha ul a {
    padding: 0.45rem 0;
    font-size: 0.88rem;
  }
  .kraje {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 2.5rem;
  }
  .kraje li {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0;
    border-bottom: 1px solid var(--line);
    break-inside: avoid;
    font-size: 0.95rem;
  }
  .kraje a {
    text-decoration: none;
  }
  .kraje a:hover {
    text-decoration: underline;
  }

  .majitel .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 4vw, 3rem);
    background: #17171a;
    color: #fff;
    border-radius: 24px;
    width: calc(100% - 2 * var(--gutter));
    max-width: calc(var(--wrap) - 2 * var(--gutter));
  }
  .majitel__citat {
    font-family: var(--f-display);
    font-size: clamp(1.3rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    max-width: 30ch;
    margin: 0;
  }
  .majitel__citat em {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .majitel .btn {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    border-color: transparent;
  }

  @media (max-width: 760px) {
    .dva,
    .o-webu__in {
      grid-template-columns: 1fr;
    }
    .cisla {
      grid-template-columns: repeat(2, 1fr);
    }
    .kraje {
      columns: 1;
    }
  }
</style>
