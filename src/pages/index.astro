---
import Base from '../layouts/Base.astro';
import Hledani from '../components/Hledani.astro';
import Magazin from '../components/Magazin.astro';
import Vybrane from '../components/Vybrane.astro';
import { KRAJE } from '../lib/kraje';
import { PROVOZOVNY, nejvetsiMesta, krajUrl, mestoUrl, pocetText, tyden } from '../lib/data';
import { SITE } from '../lib/config';

const top = nejvetsiMesta(24);
// Karty „Nejbližší salon, který…“: čísla z katalogu, „otevřeno teď“ se dopočítá v prohlížeči
const tydny = PROVOZOVNY.map((p) => tyden(p)).filter((t) => !!t);
const cislo = (n: number) => n.toLocaleString('cs-CZ');
const pocetBarber = PROVOZOVNY.filter((p) => p.typ === 'barber').length;
const pocetSobota = tydny.filter((t) => t[5]?.length).length;
const pocetVecer = tydny.filter((t) => t.slice(0, 5).some((d) => d.some(([, k]) => k >= 19 * 60))).length;
const karty = [
  { href: '/okoli/?open=1', cislo: 'Podle aktuálního času', titul: 'Otevřeno teď', popis: 'Salony, kam můžete zajít ještě dnes', zive: true },
  { href: '/okoli/?typ=1', cislo: `${cislo(pocetBarber)} salonů`, titul: 'Barbershopy', popis: 'Fade, úprava vousů, holení břitvou' },
  { href: '/okoli/?sobota=1', cislo: `${cislo(pocetSobota)} salonů`, titul: 'Otevřeno v sobotu', popis: 'Když přes týden nestíháte' },
  { href: '/okoli/?vecer=1', cislo: `${cislo(pocetVecer)} salonů`, titul: 'Otevřeno večer', popis: 'Po práci, do 19:00 i déle' },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.nazev,
    url: SITE.url,
    inLanguage: 'cs',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/hledat/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.nazev,
    url: SITE.url,
    logo: `${SITE.url}/icon-512.png`,
    email: SITE.email,
  },
];
---

<Base
  title="Najdi kadeřnictví a barbershop ve svém městě"
  description={`Najděte kadeřnictví nebo barbershop kousek od vás: ${pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR. Hned uvidíte, kdo má otevřeno, telefon i cestu. Bez registrace.`}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero__in">
      <h1>Kadeřnictví a barbershopy ve vašem okolí</h1>
      <p class="hero__sub">
        {pocetText(PROVOZOVNY.length, 'salon', 'salony', 'salonů')} v celé ČR s otevírací dobou, telefonem a cestou. Včetně salonů, které nemají vlastní web.
      </p>
      <div class="hero__srch"><Hledani /></div>
      <p class="hero__mesta">
        <span>Často hledané:</span>
        {top.slice(0, 8).map((m) => <a href={mestoUrl(m.slug)}>{m.nazev}</a>)}
      </p>
    </div>
  </section>

  <section class="rychle" aria-labelledby="rychle-h">
    <div class="wrap">
      <h2 id="rychle-h" class="sr-only">Rychlé hledání v okolí</h2>
      <ul class="rychle__list">
        {
          karty.map((k) => (
            <li>
              <a href={k.href} class="rk">
                <span class="rk__cislo" data-zive={k.zive ? '' : undefined}>{k.cislo}</span>
                <strong class="rk__titul">{k.titul}</strong>
                <span class="rk__popis">{k.popis}</span>
                <span class="rk__sipka" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <script type="application/json" id="rychle-tydny" set:html={JSON.stringify(tydny)} />
      <p class="rychle__pozn">Hledání v okolí použije vaši polohu jen v prohlížeči, nikam ji neukládáme.</p>
    </div>
  </section>

  <Vybrane />

  <Magazin />

  <section class="section majitel">
    <div class="wrap">
      <div>
        <h2 class="majitel__h">Máte salon?</h2>
        <p class="majitel__text">Doplňte ceník, fotky a aktuální otevírací dobu. Profil je zdarma a zákazníci vás najdou i bez vlastního webu.</p>
      </div>
      <a class="btn" href="/pridat-provozovnu/">Přidat nebo upravit salon</a>
    </div>
  </section>

  <nav class="rozcestnik" aria-label="Kadeřnictví podle měst a krajů">
    <div class="wrap">
      <p class="rozcestnik__h">Kadeřnictví podle měst</p>
      <ul>
        {top.map((m) => <li><a href={mestoUrl(m.slug)}>{m.nazev}</a></li>)}
      </ul>
      <p class="rozcestnik__h">Podle krajů</p>
      <ul>
        {KRAJE.map((k) => <li><a href={krajUrl(k.slug)}>{k.nazev}</a></li>)}
      </ul>
    </div>
  </nav>
</Base>


<script>
  import { stav } from '../scripts/stav';
  // Živý počet salonů, které mají právě otevřeno
  try {
    const el = document.querySelector<HTMLElement>('.rk__cislo[data-zive]');
    const data = document.getElementById('rychle-tydny')?.textContent;
    if (el && data) {
      const n = (JSON.parse(data) as [number, number][][][]).filter((t) => stav(t).open).length;
      if (n) el.textContent = `${n.toLocaleString('cs-CZ')} má otevřeno`;
    }
  } catch {
    /* bez živého počtu zůstane statický štítek */
  }
</script>


<style>
  .hero {
    position: relative;
    z-index: 5;
    padding: calc(68px + clamp(40px, 7vw, 96px)) 0 clamp(28px, 4vw, 44px);
    background: var(--paper);
  }
  .hero__in {
    max-width: var(--wrap);
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 1rem;
    max-width: 18ch;
  }
  .hero__sub {
    margin: 0 0 2rem;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.55;
    max-width: 52ch;
  }
  .hero__srch {
    max-width: 46rem;
  }
  .hero__srch :global(.srch) {
    max-width: none;
  }
  .hero__mesta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 1.1rem 0 0;
    max-width: 46rem;
    font-size: 0.9rem;
  }
  .hero__mesta span {
    color: var(--ink-soft);
  }
  .hero__mesta a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 150ms var(--ease-out);
  }
  @media (hover: hover) {
    .hero__mesta a:hover {
      text-decoration-color: var(--ink);
    }
  }

  .rychle {
    padding: 0;
  }
  .rychle__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .rychle__list li + li {
    border-left: 1px solid var(--line);
  }
  .rk {
    position: relative;
    display: grid;
    gap: 0.2rem;
    height: 100%;
    padding: 1.25rem 2.75rem 1.3rem 1.25rem;
    color: var(--ink);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 150ms var(--ease-out);
  }
  .rk:active {
    background: var(--mint);
  }
  @media (hover: hover) {
    .rk:hover {
      background: var(--mint);
      color: var(--ink);
    }
    .rk:hover .rk__sipka {
      transform: translateX(3px);
      color: var(--ink);
    }
  }
  .rk__cislo {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }
  .rk__cislo[data-zive]::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--open);
  }
  .rk__titul {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .rk__popis {
    font-size: 0.85rem;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .rk__sipka {
    position: absolute;
    right: 1.1rem;
    top: 50%;
    margin-top: -0.6em;
    color: var(--ink-soft);
    transition:
      transform 200ms var(--ease-out),
      color 150ms var(--ease-out);
  }
  .rychle__pozn {
    margin: 0.65rem 0 0;
    font-size: 0.78rem;
    color: var(--ink-soft);
  }
  @media (max-width: 860px) {
    .rychle__list {
      grid-template-columns: 1fr 1fr;
    }
    .rychle__list li:nth-child(3) {
      border-left: 0;
    }
    .rychle__list li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding: calc(68px + 32px) 0 24px;
    }
    .hero h1 {
      font-size: 2.15rem;
    }
    .hero__sub {
      margin-bottom: 1.5rem;
    }
    .hero__mesta a:nth-of-type(n + 7) {
      display: none;
    }
    .rk {
      padding: 1rem 2.25rem 1.05rem 1rem;
    }
    .rk__popis {
      display: none;
    }
  }

  .majitel {
    padding-block: clamp(48px, 7vw, 88px) clamp(32px, 5vw, 56px);
  }
  .majitel .wrap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
  }
  .majitel .wrap > div {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    flex: 1 1 28rem;
  }
  .majitel .btn {
    margin-top: 2rem;
  }
  .majitel__h {
    margin: 0 0 0.4rem;
  }
  .majitel__text {
    margin: 0;
    color: var(--ink-soft);
    max-width: 56ch;
  }

  .rozcestnik {
    padding: 2rem 0 2.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .rozcestnik__h {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--ink);
  }
  .rozcestnik ul {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .rozcestnik ul:last-child {
    margin-bottom: 0;
  }
  .rozcestnik a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  @media (hover: hover) {
    .rozcestnik a:hover {
      color: var(--ink);
      text-decoration: underline;
    }
  }
</style>
