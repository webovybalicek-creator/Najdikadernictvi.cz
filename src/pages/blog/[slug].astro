  }
  .text :global(h2) {
    font-size: clamp(1.5rem, 2.8vw, 1.9rem);
    font-weight: 400;
    margin: 2.75rem 0 1rem;
    scroll-margin-top: 1.5rem;
  }
  .text :global(p) {
    max-width: none;
  }
  .text :global(ul),
  .text :global(ol) {
    padding-left: 1.3rem;
    margin: 0 0 1.25rem;
  }
  .text :global(li) {
    margin-bottom: 0.5rem;
  }
  .text :global(li::marker) {
    color: var(--brass);
  }
  .text :global(strong) {
    font-weight: 600;
  }
  .text :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin: 1.5rem 0 2rem;
  }
  .text :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0 2rem;
    font-size: 0.95rem;
  }
  .text :global(th),
  .text :global(td) {
    text-align: left;
    padding: 0.7rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .text :global(th) {
    font-weight: 600;
    background: var(--mint);
  }
  .text :global(a) {
    text-decoration-color: var(--brass);
  }


  .ctete {
    margin-top: 2rem;
  }
  .ctete ul,
  .ctete-text ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .ctete li {
    padding: 0.45rem 0;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .ctete-text {
    margin: 2.5rem 0 0;
    padding: 1.25rem 1.5rem;
    border-left: 3px solid var(--bottle);
    background: var(--surface);
  }
  .ctete-text li {
    padding: 0.3rem 0;
  }
  @media (min-width: 961px) {
    .ctete-text {
      display: none;
    }
  }
  .ctete a {
    color: var(--ink-soft);
    text-decoration: none;
  }
  .ctete a:hover {
    color: var(--ink);
  }
  /* Města jako pilulky (stejně jako na úvodní stránce); přebíjí styly seznamů v textu článku */
  .text .cta__mesta {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .text .cta__mesta li {
    margin: 0;
  }
  .text .cta__mesta a {
    display: inline-flex;
    align-items: center;
    height: 36px;
    padding: 0 1rem;
    background: #fff;
    border: 1px solid var(--line-strong);
    border-radius: var(--pill);
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 150ms var(--ease-out);
  }
  @media (hover: hover) {
    .text .cta__mesta a:hover {
      border-color: var(--ink);
    }
  }
  .dalsi {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .dalsi__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: 2rem;
  }

  @media (max-width: 960px) {
    .telo {
      grid-template-columns: minmax(0, 1fr);
    }
    .bok {
      display: none;
    }
  }
</style>
