---
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BlogKarta from '../../components/BlogKarta.astro';
import KategorieBlogu from '../../components/KategorieBlogu.astro';
import { clanky } from '../../lib/blog';

const vse = await clanky();
const hlavni = vse.find((c) => c.data.hlavni) ?? vse[0];
const ostatni = vse.filter((c) => c.id !== hlavni.id);
---

<Base
  title="Rady a tipy: střihy, barvení, péče o vlasy a vousy"
  description="Články o pánských a dámských střizích, barvení vlasů, péči o vousy a vlasy a o tom, jak vybrat kadeřníka nebo barbera."
>
  <div class="wrap section">
    <Breadcrumb items={[{ nazev: 'Rady a tipy' }]} />
    <header class="hlava">
      <span class="eyebrow">Blog</span>
      <h1>Rady a <em>tipy</em></h1>
      <p class="lead">Střihy, barvení, péče o vlasy a vousy. Prakticky a bez reklamních řečí.</p>
      <KategorieBlogu />
    </header>

    <BlogKarta c={hlavni} velka />

    <div class="grid">
      {ostatni.map((c) => <BlogKarta c={c} />)}
    </div>
  </div>
</Base>

<style>
  .hlava {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: clamp(2rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2rem);
    margin-top: clamp(3rem, 7vw, 5rem);
  }
</style>
