---
import Base from '../layouts/Base.astro';
import { KRAJE } from '../lib/kraje';
import { krajUrl, pocetVKraji, mestaVKraji, pocetText } from '../lib/data';
---

<Base title="Kadeřnictví podle krajů" description="Přehled kadeřnictví a barbershopů ve všech 14 krajích České republiky.">
  <div class="wrap section">
    <h1>Kadeřnictví podle krajů</h1>
    <ul class="list">
      {
        KRAJE.map((k) => (
          <li>
            <a href={krajUrl(k.slug)}>{k.nazev}</a>
            <span class="muted">
              {pocetText(pocetVKraji(k.slug), 'salon', 'salony', 'salonů')} v {k.slug === 'praha' ? `${mestaVKraji(k.slug).filter((m) => m.slug !== 'praha').length} obvodech` : pocetText(mestaVKraji(k.slug).length, 'obci', 'obcích', 'obcích')}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    max-width: 44rem;
  }
  li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  a {
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }
</style>
