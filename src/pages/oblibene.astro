---
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Hledani from '../components/Hledani.astro';
---

<Base title="Moje oblíbené salony" description="Vaše uložená kadeřnictví a barbershopy na jednom místě." noindex>
  <div class="wrap section">
    <Breadcrumb items={[{ nazev: 'Oblíbené' }]} />
    <span class="eyebrow">Jen pro vás</span>
    <h1>Moje <em>oblíbené</em></h1>
    <p class="lead">
      Salony, které jste si uložili srdíčkem. Seznam se ukládá jen ve vašem prohlížeči, bez registrace.
    </p>

    <ul class="karty" data-oblibene-seznam></ul>

    <div class="prazdno" data-oblibene-prazdno hidden>
      <p>
        Zatím tu nic není. U salonu klikněte na <strong>♥ Do oblíbených</strong> a najdete ho tu příště na jedno
        kliknutí.
      </p>
      <Hledani />
    </div>

    <p class="odkaz-hist"><a href="/naposledy-prohlizene/">Naposledy prohlížené salony →</a></p>
  </div>
</Base>

<script>
  import { oblibene } from '../scripts/oblibene';
  import { vykresli } from '../scripts/vykresli-salony';

  const seznam = document.querySelector<HTMLElement>('[data-oblibene-seznam]')!;
  const prazdno = document.querySelector<HTMLElement>('[data-oblibene-prazdno]')!;
  const obnov = () => {
    const o = oblibene();
    vykresli(seznam, o);
    prazdno.hidden = o.length > 0;
  };
  obnov();
  // po odebrání srdíčkem zmizí karta až po chvilce, ať je vidět, co se stalo
  window.addEventListener('nk-oblibene', () => setTimeout(obnov, 400));

</script>

<style>
  .odkaz-hist {
    margin-top: 2.5rem;
  }
  .karty {
    margin-top: 2rem;
  }
  .prazdno {
    margin-top: 2rem;
    max-width: 40rem;
  }
  .hist {
    margin-top: clamp(48px, 7vw, 80px);
  }
</style>
